<Application
    x:Class="OtimizaPC.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:OtimizaPC.App.Converters"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- Cores de status (legíveis nos temas claro e escuro) -->
            <SolidColorBrush x:Key="StatusOkBrush" Color="#2EA043" />
            <SolidColorBrush x:Key="StatusInfoBrush" Color="#4C8EDA" />
            <SolidColorBrush x:Key="StatusWarningBrush" Color="#D29922" />
            <SolidColorBrush x:Key="StatusCriticalBrush" Color="#E5534B" />

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:NullToCollapsedConverter x:Key="NullToCollapsed" />
            <conv:InverseBoolConverter x:Key="InverseBool" />
            <conv:StringToSymbolConverter x:Key="StringToSymbol" />
            <conv:HealthStatusToSymbolConverter x:Key="StatusToSymbol" />
            <conv:HealthStatusToBrushConverter x:Key="StatusToBrush" />

            <Style x:Key="PageTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Style>

            <Style x:Key="PageSubtitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Margin" Value="0,4,0,20" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            </Style>

            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Style>

            <Style x:Key="SecondaryText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!-- Texto selecionável (para o técnico copiar serial, MAC etc.) sem aparência de caixa de texto -->
            <Style x:Key="SelectableText" TargetType="TextBox">
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <!-- Decorator em vez de ScrollViewer para não capturar a rolagem da página -->
                            <Decorator x:Name="PART_ContentHost" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Linha rótulo/valor usada no painel e na tela de hardware -->
            <DataTemplate x:Key="InfoEntryTemplate">
                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding Label}" />
                    <TextBox Grid.Column="1" Style="{StaticResource SelectableText}" Text="{Binding Value, Mode=OneWay}" />
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
