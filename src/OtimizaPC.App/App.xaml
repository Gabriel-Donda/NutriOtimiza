<Application
    x:Class="OtimizaPC.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:OtimizaPC.App.Converters"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- Tokens de layout: use estes valores nas Views para manter ritmo visual. -->
            <sys:Double x:Key="Spacing4">4</sys:Double>
            <sys:Double x:Key="Spacing8">8</sys:Double>
            <sys:Double x:Key="Spacing12">12</sys:Double>
            <sys:Double x:Key="Spacing16">16</sys:Double>
            <sys:Double x:Key="Spacing20">20</sys:Double>
            <sys:Double x:Key="Spacing24">24</sys:Double>
            <sys:Double x:Key="Spacing28">28</sys:Double>
            <sys:Double x:Key="ControlMinHeight">40</sys:Double>
            <sys:Double x:Key="MetricCardMinWidth">260</sys:Double>
            <sys:Double x:Key="DashboardPanelMinWidth">360</sys:Double>
            <FontFamily x:Key="AppFontFamily">Segoe UI</FontFamily>

            <!-- Identidade visual da Nutriport (brushes semânticos são atualizados no ThemeService) -->
            <SolidColorBrush x:Key="BrandGoldBrush" Color="#D2C068" />
            <SolidColorBrush x:Key="BrandOrangeBrush" Color="#F58634" />
            <SolidColorBrush x:Key="BrandGraphiteBrush" Color="#202020" />
            <SolidColorBrush x:Key="BrandTitleBrush" Color="#D2C068" />

            <SolidColorBrush x:Key="SurfaceNavigationBrush" Color="#202020" />
            <SolidColorBrush x:Key="SurfaceNavigationHoverBrush" Color="#2C2C2C" />
            <SolidColorBrush x:Key="SurfaceNavigationSelectedBrush" Color="#3A3027" />
            <SolidColorBrush x:Key="NavigationSelectedForegroundBrush" Color="#FFF4D0" />
            <SolidColorBrush x:Key="FocusStrokeBrush" Color="#F58634" />
            <SolidColorBrush x:Key="StatusWarningForegroundBrush" Color="#F8D477" />
            <SolidColorBrush x:Key="StatusCriticalForegroundBrush" Color="#FFB4AB" />
            <SolidColorBrush x:Key="StatusWarningOnFillBrush" Color="#1F1F1F" />
            <SolidColorBrush x:Key="StatusCriticalOnFillBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="LogBackgroundBrush" Color="#101010" />
            <SolidColorBrush x:Key="LogForegroundBrush" Color="#D4D4D4" />
            <SolidColorBrush x:Key="LogErrorForegroundBrush" Color="#F48771" />

            <!-- Cores de status (legíveis nos temas claro e escuro) -->
            <SolidColorBrush x:Key="StatusOkBrush" Color="#2EA043" />
            <SolidColorBrush x:Key="StatusInfoBrush" Color="#4C8EDA" />
            <SolidColorBrush x:Key="StatusWarningBrush" Color="#D29922" />
            <SolidColorBrush x:Key="StatusCriticalBrush" Color="#E5534B" />

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:NullToCollapsedConverter x:Key="NullToCollapsed" />
            <conv:NullToVisibleConverter x:Key="NullToVisible" />
            <conv:InverseBoolConverter x:Key="InverseBool" />
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <conv:ZeroToVisibleConverter x:Key="ZeroToVisible" />
            <conv:PawnIoStatusConverter x:Key="PawnIoStatus" />
            <conv:StringToSymbolConverter x:Key="StringToSymbol" />
            <conv:HealthStatusToSymbolConverter x:Key="StatusToSymbol" />
            <conv:HealthStatusToBrushConverter x:Key="StatusToBrush" />

            <Style x:Key="PageTitle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="{DynamicResource BrandTitleBrush}" />
            </Style>

            <Style x:Key="PageSubtitle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Margin" Value="0,4,0,20" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            </Style>

            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Style>

            <Style x:Key="SecondaryText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="AppFocusVisualStyle" TargetType="Control">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Control">
                            <Border
                                Margin="-2"
                                BorderBrush="{DynamicResource FocusStrokeBrush}"
                                BorderThickness="2"
                                CornerRadius="6" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Componentes compartilhados entre as Views. -->
            <Style x:Key="Badge" TargetType="Border">
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="6,1" />
                <Setter Property="Margin" Value="8,0,0,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style
                x:Key="SettingCard"
                BasedOn="{StaticResource {x:Type ui:Card}}"
                TargetType="ui:Card">
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="Padding" Value="18,14" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>

            <Style x:Key="StatusIcon" TargetType="ui:SymbolIcon">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="Margin" Value="0,1,12,0" />
                <Setter Property="VerticalAlignment" Value="Top" />
            </Style>

            <Style
                x:Key="RepairCard"
                BasedOn="{StaticResource {x:Type ui:Card}}"
                TargetType="ui:Card">
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="Padding" Value="16,10" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>

            <Style x:Key="SectionCard" BasedOn="{StaticResource {x:Type ui:Card}}" TargetType="ui:Card">
                <Setter Property="Padding" Value="20,14" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Top" />
            </Style>

            <Style x:Key="ColumnHeader" BasedOn="{StaticResource SecondaryText}" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="TableRow" TargetType="Border">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="0,4" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="DashboardMetricCard" BasedOn="{StaticResource {x:Type ui:Card}}" TargetType="ui:Card">
                <Setter Property="Focusable" Value="True" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisualStyle}" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource FocusStrokeBrush}" />
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource FocusStrokeBrush}" />
                        <Setter Property="BorderThickness" Value="2" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="DashboardMetricButton" TargetType="Button">
                <Setter Property="MinHeight" Value="140" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisualStyle}" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="MetricChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="18,16">
                                <ContentPresenter
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource FocusStrokeBrush}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource FocusStrokeBrush}" />
                                    <Setter Property="BorderThickness" Value="2" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Opacity" Value="0.82" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.55" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Texto selecionável (para o técnico copiar serial, MAC etc.) sem aparência de caixa de texto -->
            <Style x:Key="SelectableText" TargetType="TextBox">
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <!-- Decorator em vez de ScrollViewer para não capturar a rolagem da página -->
                            <Decorator x:Name="PART_ContentHost" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Linha rótulo/valor usada no painel e na tela de hardware -->
            <DataTemplate x:Key="InfoEntryTemplate">
                <Border Style="{StaticResource TableRow}" Margin="0,3">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                        <TextBox Grid.Column="1" Style="{StaticResource SelectableText}" Text="{Binding Value, Mode=OneWay}" />
                    </Grid>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
