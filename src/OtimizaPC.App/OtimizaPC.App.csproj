<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <RootNamespace>OtimizaPC.App</RootNamespace>
    <AssemblyName>NutriOtimiza</AssemblyName>
    <!-- Release exige administrador; Debug roda sem elevação para facilitar o desenvolvimento -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyTitle>NutriOtimiza</AssemblyTitle>
    <Description>Otimização, limpeza e diagnóstico do Windows</Description>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app-256.png" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <ApplicationManifest>app.debug.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OtimizaPC.Core\OtimizaPC.Core.csproj" />
    <ProjectReference Include="..\OtimizaPC.Hardware\OtimizaPC.Hardware.csproj" />
    <ProjectReference Include="..\OtimizaPC.Cleaning\OtimizaPC.Cleaning.csproj" />
    <ProjectReference Include="..\OtimizaPC.Tweaks\OtimizaPC.Tweaks.csproj" />
    <ProjectReference Include="..\OtimizaPC.Repair\OtimizaPC.Repair.csproj" />
  </ItemGroup>

</Project>
