<UserControl
    x:Class="OtimizaPC.App.Views.AppsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <DockPanel Margin="28,24,28,0">
        <!-- Cabeçalho -->
        <StackPanel DockPanel.Dock="Top">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ui:Button
                        Margin="0,0,8,0"
                        Appearance="Secondary"
                        Command="{Binding RefreshCommand}"
                        Content="Atualizar"
                        Icon="{ui:SymbolIcon ArrowSync24}" />
                    <ui:Button
                        Appearance="Primary"
                        Command="{Binding RemoveCommand}"
                        Content="{Binding RemoveText}"
                        Icon="{ui:SymbolIcon Delete24}" />
                </StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="Apps pré-instalados" TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <TextBlock Style="{StaticResource PageSubtitle}" Text="Remova propaganda e apps que vieram com o Windows ou com o PC e você não usa." TextWrapping="Wrap" />

            <!-- Barra de seleção rápida -->
            <Border
                Margin="0,0,0,8"
                Padding="12,8"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <ui:Button
                            Margin="8,0,0,0"
                            Appearance="Transparent"
                            Command="{Binding SelectRecommendedCommand}"
                            Content="Recomendados" />
                        <ui:Button
                            Margin="8,0,0,0"
                            Appearance="Transparent"
                            Command="{Binding SelectNoneCommand}"
                            Content="Nenhum" />
                    </StackPanel>
                    <CheckBox
                        VerticalAlignment="Center"
                        Content="Remover também para novos usuários deste PC"
                        IsChecked="{Binding AlsoForNewUsers}"
                        IsEnabled="{Binding CanRemoveForNewUsers}" />
                </DockPanel>
            </Border>

            <StackPanel Margin="4,0,0,12" Orientation="Horizontal">
                <ui:ProgressRing
                    Width="16"
                    Height="16"
                    Margin="0,0,8,0"
                    IsIndeterminate="True"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding StatusMessage}" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,28">
                <!-- Apps removidos pelo OtimizaPC -->
                <ui:Card
                    Margin="0,0,0,12"
                    Padding="20,16"
                    HorizontalContentAlignment="Stretch"
                    Visibility="{Binding HasRemoved, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="20">
                                <ui:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" Foreground="{DynamicResource StatusOkBrush}" Symbol="Checkmark24" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="Removidos pelo NutriOtimiza" />
                                <TextBlock Style="{StaticResource SecondaryText}" Text="Reinstalar usa os arquivos que ainda estão no PC; se não existirem mais, abre a Microsoft Store." />
                            </StackPanel>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Removed}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource TableRow}" Margin="0,2" Padding="8">
                                        <DockPanel>
                                            <ui:Button
                                                Appearance="Secondary"
                                                Command="{Binding ReinstallCommand}"
                                                CommandParameter="{Binding}"
                                                Content="Reinstalar"
                                                DockPanel.Dock="Right"
                                                Icon="{ui:SymbolIcon ArrowUndo24}" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Center">
                                                    <Image Width="32" Height="32" Source="{Binding Icon}" Stretch="Uniform" />
                                                    <ui:SymbolIcon Width="32" Height="32" FontSize="22" Symbol="AppStore24" Visibility="{Binding Icon, Converter={StaticResource NullToVisible}}" />
                                                </Grid>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" TextWrapping="Wrap" />
                                                    <TextBlock FontSize="12" Style="{StaticResource SecondaryText}" Text="{Binding Detail}" />
                                                </StackPanel>
                                            </Grid>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ui:Card>

                <!-- Apps instalados por grupo -->
                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:Card
                                Margin="0,0,0,12"
                                Padding="20,16"
                                HorizontalContentAlignment="Stretch">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="40" Height="40" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="20">
                                            <ui:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Symbol="AppStore24" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Name}" />
                                            <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding Hint}" />
                                        </StackPanel>
                                        <Border Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Padding="10,3" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10">
                                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Items.Count}" />
                                        </Border>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource TableRow}" Margin="0,2" Padding="8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox
                                                            AutomationProperties.Name="{Binding DisplayName}"
                                                            MinWidth="0"
                                                            Margin="0,2,12,0"
                                                            VerticalAlignment="Top"
                                                            IsChecked="{Binding IsSelected}" />
                                                        <Grid Grid.Column="1" Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Top">
                                                            <Image Width="32" Height="32" Source="{Binding Icon}" Stretch="Uniform" />
                                                            <ui:SymbolIcon Width="32" Height="32" FontSize="22" Symbol="AppStore24" Visibility="{Binding Icon, Converter={StaticResource NullToVisible}}" />
                                                        </Grid>
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding Description}" TextWrapping="Wrap" />
                                                            <TextBlock
                                                                FontSize="11"
                                                                Style="{StaticResource SecondaryText}"
                                                                Text="{Binding PackageName}" />
                                                            <StackPanel
                                                                Margin="0,4,0,0"
                                                                Orientation="Horizontal"
                                                                Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}">
                                                                <ui:SymbolIcon
                                                                    Margin="0,1,6,0"
                                                                    FontSize="14"
                                                                    Foreground="{DynamicResource StatusWarningBrush}"
                                                                    Symbol="Warning24" />
                                                                <TextBlock
                                                                    FontSize="12"
                                                                    Foreground="{DynamicResource StatusWarningBrush}"
                                                                    Text="Será removido" />
                                                            </StackPanel>
                                                            <TextBlock
                                                                Margin="0,4,0,0"
                                                                FontSize="12"
                                                                Foreground="{DynamicResource StatusCriticalBrush}"
                                                                Text="{Binding StatusText}"
                                                                TextWrapping="Wrap"
                                                                Visibility="{Binding StatusText, Converter={StaticResource NullToCollapsed}}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ui:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Estado vazio -->
                <ui:Card
                    Margin="0,0,0,12"
                    Padding="32"
                    HorizontalContentAlignment="Center"
                    Visibility="{Binding HasItems, Converter={StaticResource InverseBoolToVisibility}}">
                    <StackPanel HorizontalAlignment="Center" MaxWidth="420">
                        <Border
                            Width="56"
                            Height="56"
                            HorizontalAlignment="Center"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            CornerRadius="28">
                            <ui:SymbolIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="26"
                                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                Symbol="Apps24" />
                        </Border>
                        <TextBlock
                            Margin="0,16,0,0"
                            HorizontalAlignment="Center"
                            FontSize="17"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="Nenhum app disponível"
                            TextAlignment="Center" />
                        <TextBlock
                            Margin="0,6,0,0"
                            HorizontalAlignment="Center"
                            Style="{StaticResource SecondaryText}"
                            Text="Não há apps pré-instalados elegíveis para remoção neste momento."
                            TextAlignment="Center" />
                    </StackPanel>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
