<UserControl
    x:Class="OtimizaPC.App.Views.AppsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <DockPanel Margin="28,24,28,0">
        <!-- Cabeçalho -->
        <StackPanel DockPanel.Dock="Top">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ui:Button
                        Margin="0,0,8,0"
                        Appearance="Secondary"
                        Command="{Binding RefreshCommand}"
                        Content="Atualizar"
                        Icon="{ui:SymbolIcon ArrowSync24}" />
                    <ui:Button
                        Appearance="Primary"
                        Command="{Binding RemoveCommand}"
                        Content="{Binding RemoveText}"
                        Icon="{ui:SymbolIcon Delete24}" />
                </StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="Apps pré-instalados" />
            </DockPanel>
            <TextBlock Style="{StaticResource PageSubtitle}" Text="Remova propaganda e apps que vieram com o Windows ou com o PC e você não usa." />

            <DockPanel Margin="0,0,0,8">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ui:Button
                        Appearance="Transparent"
                        Command="{Binding SelectRecommendedCommand}"
                        Content="Recomendados" />
                    <ui:Button
                        Appearance="Transparent"
                        Command="{Binding SelectNoneCommand}"
                        Content="Nenhum" />
                </StackPanel>
                <CheckBox
                    Content="Remover também para novos usuários deste PC"
                    IsChecked="{Binding AlsoForNewUsers}"
                    IsEnabled="{Binding CanRemoveForNewUsers}" />
            </DockPanel>
            <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                <ui:ProgressRing
                    Width="16"
                    Height="16"
                    Margin="0,0,8,0"
                    IsIndeterminate="True"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding StatusMessage}" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,28">
                <!-- Apps removidos pelo OtimizaPC -->
                <ui:Card
                    Margin="0,0,0,12"
                    Padding="20,14"
                    HorizontalContentAlignment="Stretch"
                    Visibility="{Binding HasRemoved, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Removidos pelo NutriOtimiza" />
                        <TextBlock
                            Margin="0,2,0,8"
                            Style="{StaticResource SecondaryText}"
                            Text="Reinstalar usa os arquivos que ainda estão no PC; se não existirem mais, abre a Microsoft Store." />
                        <ItemsControl ItemsSource="{Binding Removed}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,6">
                                        <ui:Button
                                            Appearance="Secondary"
                                            Command="{Binding ReinstallCommand}"
                                            CommandParameter="{Binding}"
                                            Content="Reinstalar"
                                            DockPanel.Dock="Right"
                                            Icon="{ui:SymbolIcon ArrowUndo24}" />
                                        <Grid>
                                            <Image Width="32" Height="32" Margin="0,0,10,0" VerticalAlignment="Center" Source="{Binding Icon}" Stretch="Uniform" />
                                            <ui:SymbolIcon Width="32" Height="32" Margin="0,0,10,0" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="22" Symbol="AppStore24" Visibility="{Binding Icon, Converter={StaticResource NullToVisible}}" />
                                            <StackPanel Margin="42,0,0,0">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                            <TextBlock
                                                FontSize="12"
                                                Style="{StaticResource SecondaryText}"
                                                Text="{Binding Detail}" />
                                            </StackPanel>
                                        </Grid>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ui:Card>

                <!-- Apps instalados por grupo -->
                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:Card
                                Margin="0,0,0,12"
                                Padding="20,14"
                                HorizontalContentAlignment="Stretch">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Name}" />
                                    <TextBlock
                                        Margin="0,2,0,8"
                                        Style="{StaticResource SecondaryText}"
                                        Text="{Binding Hint}" />
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox
                                                        MinWidth="0"
                                                        Margin="0,0,8,0"
                                                        VerticalAlignment="Top"
                                                        IsChecked="{Binding IsSelected}" />
                                            <Image Grid.Column="1" Width="32" Height="32" Margin="0,0,8,0" HorizontalAlignment="Left" VerticalAlignment="Top" Source="{Binding Icon}" Stretch="Uniform" />
                                            <ui:SymbolIcon Grid.Column="1" Width="32" Height="32" Margin="0,0,8,0" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="22" Symbol="AppStore24" Visibility="{Binding Icon, Converter={StaticResource NullToVisible}}" />
                                            <StackPanel Grid.Column="1" Margin="40,0,0,0">
                                                        <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                                        <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding Description}" />
                                                        <TextBlock
                                                            FontSize="11"
                                                            Style="{StaticResource SecondaryText}"
                                                            Text="{Binding PackageName}" />
                                                        <TextBlock
                                                            FontSize="12"
                                                            Foreground="{DynamicResource StatusCriticalBrush}"
                                                            Text="{Binding StatusText}"
                                                            TextWrapping="Wrap"
                                                            Visibility="{Binding StatusText, Converter={StaticResource NullToCollapsed}}" />
                                            </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ui:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
