<UserControl
    x:Class="OtimizaPC.App.Views.CleanupView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <UserControl.Resources>
        <!-- Etiqueta pequena (ex.: "Efeito colateral") -->
        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="28,24,28,0">
        <!-- Cabeçalho -->
        <StackPanel DockPanel.Dock="Top">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ui:Button
                        Margin="0,0,8,0"
                        Appearance="Secondary"
                        Command="{Binding CancelCommand}"
                        Content="Cancelar"
                        Icon="{ui:SymbolIcon Dismiss24}"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <ui:Button
                        Margin="0,0,8,0"
                        Appearance="Secondary"
                        Command="{Binding ScanCommand}"
                        Content="Analisar"
                        Icon="{ui:SymbolIcon Search24}" />
                    <ui:Button
                        Appearance="Primary"
                        Command="{Binding CleanCommand}"
                        Icon="{ui:SymbolIcon Broom24}">
                        <TextBlock>
                            <Run Text="Limpar" />
                            <Run Text="{Binding SelectedTotalText, Mode=OneWay}" />
                        </TextBlock>
                    </ui:Button>
                </StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="Limpeza" />
            </DockPanel>

            <TextBlock
                Margin="0,12,0,0"
                FontSize="20"
                FontWeight="SemiBold"
                Text="{Binding Headline}" />
            <ProgressBar
                Height="4"
                Margin="0,10,0,0"
                Maximum="100"
                Value="{Binding Progress}"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <DockPanel Margin="0,8,0,14">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ui:Button
                        Appearance="Transparent"
                        Command="{Binding SelectRecommendedCommand}"
                        Content="Recomendados" />
                    <ui:Button
                        Appearance="Transparent"
                        Command="{Binding SelectNoneCommand}"
                        Content="Nenhum" />
                </StackPanel>
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource SecondaryText}"
                    Text="{Binding StatusMessage}" />
            </DockPanel>
        </StackPanel>

        <!-- Itens por grupo -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <ItemsControl Margin="0,0,0,28" ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:Card
                            Margin="0,0,0,12"
                            Padding="20,14"
                            HorizontalContentAlignment="Stretch">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,8"
                                    Style="{StaticResource SectionTitle}"
                                    Text="{Binding Name}" />
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,6" IsEnabled="{Binding IsEnabled}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="120" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox
                                                    MinWidth="0"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Top"
                                                    IsChecked="{Binding IsSelected}" />
                                                <StackPanel Grid.Column="1">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                                        <Border
                                                            Background="{DynamicResource StatusWarningBrush}"
                                                            Style="{StaticResource Badge}"
                                                            Visibility="{Binding IsModerate, Converter={StaticResource BoolToVisibility}}">
                                                            <TextBlock
                                                                FontSize="11"
                                                                Foreground="Black"
                                                                Text="Efeito colateral" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock
                                                        Margin="0,2,0,0"
                                                        Style="{StaticResource SecondaryText}"
                                                        Text="{Binding Description}" />
                                                    <TextBlock
                                                        Margin="0,2,0,0"
                                                        FontSize="12"
                                                        Text="{Binding StatusText}"
                                                        TextWrapping="Wrap"
                                                        Visibility="{Binding StatusText, Converter={StaticResource NullToCollapsed}}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource StatusWarningBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock
                                                    Grid.Column="2"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    FontSize="15"
                                                    FontWeight="SemiBold"
                                                    Text="{Binding SizeText}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
