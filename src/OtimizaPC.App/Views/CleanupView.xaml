<UserControl x:Class="OtimizaPC.App.Views.CleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <Style x:Key="CleanupGroupHeaderButton" TargetType="Button">
            <Setter Property="Padding" Value="4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="HeaderChrome" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderChrome" Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="HeaderChrome" Property="BorderBrush" Value="{DynamicResource FocusStrokeBrush}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="HeaderChrome" Property="Opacity" Value="0.82" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="28,24,28,0">
        <StackPanel DockPanel.Dock="Top">
            <DockPanel>
                <WrapPanel DockPanel.Dock="Right" Margin="12,0,0,0">
                    <ui:Button Appearance="Primary" Command="{Binding CancelCommand}" Content="Cancelar" Icon="{ui:SymbolIcon Dismiss24}" Visibility="{Binding ShowCancel, Converter={StaticResource BoolToVisibility}}" />
                    <ui:Button Appearance="Primary" Command="{Binding ScanCommand}" Content="Analisar" Icon="{ui:SymbolIcon Search24}" Visibility="{Binding ShowPrimaryScan, Converter={StaticResource BoolToVisibility}}" />
                    <ui:Button Appearance="Secondary" Command="{Binding ScanCommand}" Content="Analisar novamente" Icon="{ui:SymbolIcon Search24}" Visibility="{Binding ShowSecondaryScan, Converter={StaticResource BoolToVisibility}}" />
                    <ui:Button Margin="8,0,0,0" Appearance="Primary" Command="{Binding CleanCommand}" Icon="{ui:SymbolIcon Broom24}" Visibility="{Binding ShowClean, Converter={StaticResource BoolToVisibility}}"><TextBlock><Run Text="Limpar " /><Run Text="{Binding SelectedTotalText, Mode=OneWay}" /></TextBlock></ui:Button>
                </WrapPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="Limpeza" TextTrimming="CharacterEllipsis" />
            </DockPanel>

            <ui:Card Margin="0,14,12,12" Padding="20,16" HorizontalContentAlignment="Stretch">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Width="48" Height="48" Margin="0,0,14,0" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="24">
                        <ui:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="25" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Symbol="Broom24" />
                    </Border>
                    <Grid Grid.Column="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SecondaryText}" Text="Espaço selecionado para liberar" />
                            <TextBlock FontSize="30" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding SelectedTotalText}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Progress, StringFormat={}{0:0}%}" />
                    </Grid>
                </Grid>
            </ui:Card>

            <ProgressBar Height="8" Margin="0,0,12,0" Maximum="100" Value="{Binding Progress}" />
            <DockPanel Margin="0,5,12,12">
                <WrapPanel DockPanel.Dock="Right">
                    <ui:Button Appearance="Transparent" Command="{Binding CollapseAllCommand}" Content="Recolher tudo" />
                    <ui:Button Appearance="Transparent" Command="{Binding ExpandAllCommand}" Content="Expandir tudo" />
                    <ui:Button Appearance="Transparent" Command="{Binding SelectRecommendedCommand}" Content="Recomendados" />
                    <ui:Button Appearance="Transparent" Command="{Binding SelectNoneCommand}" Content="Nenhum" />
                </WrapPanel>
                <StackPanel>
                    <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding Headline}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding ProgressText}" />
                    <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </StackPanel>

        <ScrollViewer Margin="0,0,0,24" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,0">
                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:Card Style="{StaticResource SectionCard}" Margin="0,0,0,12" Padding="16,12" HorizontalContentAlignment="Stretch">
                                <StackPanel>
                                    <Button Style="{StaticResource CleanupGroupHeaderButton}" AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="Expande ou recolhe os itens deste grupo." Command="{Binding DataContext.ToggleGroupCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="{Binding}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <Border Width="42" Height="42" CornerRadius="21" Background="{DynamicResource ControlFillColorDefaultBrush}"><ui:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="22" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Symbol="{Binding Icon}" /></Border>
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Name}" /><TextBlock Style="{StaticResource SecondaryText}" Text="{Binding ItemCount, StringFormat={}{0} itens}" /></StackPanel>
                                            <TextBlock Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource SecondaryText}" Text="{Binding ToggleHint}" />
                                            <ui:SymbolIcon Grid.Column="3" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="20" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Symbol="ChevronDown24">
                                                <ui:SymbolIcon.Style><Style TargetType="ui:SymbolIcon"><Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="0" /></Setter.Value></Setter><Style.Triggers><DataTrigger Binding="{Binding IsExpanded}" Value="True"><DataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle" To="180" Duration="0:0:0.15" /></Storyboard></BeginStoryboard></DataTrigger.EnterActions><DataTrigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle" To="0" Duration="0:0:0.15" /></Storyboard></BeginStoryboard></DataTrigger.ExitActions></DataTrigger></Style.Triggers></Style></ui:SymbolIcon.Style>
                                            </ui:SymbolIcon>
                                        </Grid>
                                    </Button>

                                    <ItemsControl Margin="4,14,4,0" ItemsSource="{Binding Items}" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource TableRow}" Margin="0,2" Padding="4,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <CheckBox Margin="0,0,10,0" VerticalAlignment="Top" IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsEnabled}" />
                                                        <Grid Grid.Column="1" Width="32" Height="32" Margin="0,0,10,0" VerticalAlignment="Top"><Image Width="32" Height="32" Source="{Binding Icon}" Stretch="Uniform" Visibility="{Binding Icon, Converter={StaticResource NullToCollapsed}}" /><ui:SymbolIcon Width="32" Height="32" FontSize="22" Symbol="AppStore24" Visibility="{Binding Icon, Converter={StaticResource NullToVisible}}" /></Grid>
                                                        <StackPanel Grid.Column="2" Margin="0,0,12,0">
                                                            <DockPanel LastChildFill="True"><Border DockPanel.Dock="Right" Background="{DynamicResource StatusWarningBrush}" Style="{StaticResource Badge}" Visibility="{Binding IsModerate, Converter={StaticResource BoolToVisibility}}"><TextBlock FontSize="11" Foreground="{DynamicResource StatusWarningOnFillBrush}" Text="Efeito colateral" /></Border><Border DockPanel.Dock="Right" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource StatusWarningBrush}" BorderThickness="1" Style="{StaticResource Badge}" Visibility="{Binding IsEnabled, Converter={StaticResource InverseBoolToVisibility}}"><TextBlock FontSize="11" Foreground="{DynamicResource StatusWarningForegroundBrush}" Text="Requer administrador" /></Border><TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Name}" TextWrapping="Wrap" /></DockPanel>
                                                            <TextBlock Margin="0,2,0,0" Style="{StaticResource SecondaryText}" Text="{Binding Description}" TextWrapping="Wrap" />
                                                            <TextBlock Margin="0,2,0,0" FontSize="12" Text="{Binding StatusText}" TextWrapping="Wrap" Visibility="{Binding StatusText, Converter={StaticResource NullToCollapsed}}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" /><Style.Triggers><DataTrigger Binding="{Binding IsBlocked}" Value="True"><Setter Property="Foreground" Value="{DynamicResource StatusWarningBrush}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="3" Width="128" HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding SizeText}" TextAlignment="Right" TextWrapping="Wrap" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ui:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ui:Card Margin="0,0,0,28" Padding="24" HorizontalContentAlignment="Stretch" Visibility="{Binding Groups.Count, Converter={StaticResource ZeroToVisible}}"><StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="Nenhum item de limpeza disponível" /><TextBlock Margin="0,6,0,0" Style="{StaticResource SecondaryText}" Text="Nenhum item de limpeza está disponível neste computador." TextWrapping="Wrap" /></StackPanel></ui:Card>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
