<UserControl x:Class="OtimizaPC.App.Views.StartupView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <DockPanel Margin="28,24,28,0">
        <StackPanel DockPanel.Dock="Top"><DockPanel><ui:Button Appearance="Secondary" Command="{Binding RefreshCommand}" Content="Atualizar" DockPanel.Dock="Right" Icon="{ui:SymbolIcon ArrowSync24}"/><TextBlock Style="{StaticResource PageTitle}" Text="Inicialização" TextTrimming="CharacterEllipsis"/></DockPanel><TextBlock Style="{StaticResource PageSubtitle}" Text="{Binding Summary}" TextWrapping="Wrap"/><TextBlock Margin="0,-12,0,12" Foreground="{DynamicResource StatusWarningBrush}" Text="{Binding StatusMessage}" TextWrapping="Wrap" Visibility="{Binding StatusMessage, Converter={StaticResource NullToCollapsed}}"/></StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,0,24"><ui:Card Padding="24" HorizontalContentAlignment="Stretch" Visibility="{Binding HasItems, Converter={StaticResource InverseBoolToVisibility}}"><StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="Nenhum item de inicialização encontrado"/><TextBlock Margin="0,6,0,0" Style="{StaticResource SecondaryText}" Text="O Windows não informou programas configurados para iniciar com esta conta." TextWrapping="Wrap"/></StackPanel></ui:Card><ItemsControl ItemsSource="{Binding Items}"><ItemsControl.ItemTemplate><DataTemplate>
            <ui:Card Margin="0,0,0,10" Padding="16" HorizontalContentAlignment="Stretch"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid Width="48" Height="48" Margin="0,0,14,0"><Image Width="40" Height="40" Source="{Binding Icon}" Stretch="Uniform"/><ui:SymbolIcon Width="40" Height="40" FontSize="26" Symbol="AppStore24" Visibility="{Binding Icon, Converter={StaticResource NullToVisible}}"/></Grid>
                <StackPanel Grid.Column="1"><TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding Name}"/><TextBlock Style="{StaticResource SecondaryText}" Text="{Binding Publisher}"/><TextBlock FontSize="11" Style="{StaticResource SecondaryText}" Text="{Binding Location}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Location}"/><TextBlock FontSize="11" Style="{StaticResource SecondaryText}" Text="{Binding Command}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Command}"/></StackPanel>
                <StackPanel Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center"><Border Margin="0,0,0,8" Padding="8,3" HorizontalAlignment="Right" CornerRadius="9" Background="{DynamicResource StatusOkBrush}" Visibility="{Binding IsEnabled, Converter={StaticResource BoolToVisibility}}"><TextBlock FontSize="11" FontWeight="SemiBold" Foreground="White" Text="Ativo"/></Border><Border Margin="0,0,0,8" Padding="8,3" HorizontalAlignment="Right" CornerRadius="9" Background="{DynamicResource TextFillColorSecondaryBrush}" Visibility="{Binding IsEnabled, Converter={StaticResource InverseBoolToVisibility}}"><TextBlock FontSize="11" FontWeight="SemiBold" Foreground="White" Text="Inativo"/></Border><StackPanel Orientation="Horizontal"><ui:Button Margin="0,0,6,0" Appearance="Secondary" Command="{Binding ToggleEnabledCommand}" Content="{Binding ActionText}" IsEnabled="{Binding CanToggle}"/><ui:Button Appearance="Transparent" Command="{Binding OpenLocationCommand}" Icon="{ui:SymbolIcon FolderOpen24}" ToolTip="Abrir local do arquivo"/></StackPanel><ui:ToggleSwitch Margin="0,6,0,0" HorizontalAlignment="Right" IsChecked="{Binding IsEnabled}" IsEnabled="{Binding CanToggle}"/></StackPanel>
            </Grid></ui:Card>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer>
    </DockPanel>
</UserControl>
