<UserControl x:Class="OtimizaPC.App.Views.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <DockPanel Margin="28,24,28,0">
        <StackPanel DockPanel.Dock="Top">
            <DockPanel>
                <ui:Button Appearance="Secondary" Command="{Binding RefreshCommand}" Content="Atualizar" DockPanel.Dock="Right" Icon="{ui:SymbolIcon ArrowSync24}" />
                <TextBlock Style="{StaticResource PageTitle}" Text="Inicialização" TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <TextBlock Style="{StaticResource PageSubtitle}" Text="{Binding Summary}" TextWrapping="Wrap" />
            <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                <ui:ProgressRing Width="16" Height="16" Margin="0,0,8,0" IsIndeterminate="True" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Style="{StaticResource SecondaryText}" Text="Carregando programas de inicialização…" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
            <TextBlock Margin="0,0,0,12" Foreground="{DynamicResource StatusCriticalForegroundBrush}" Text="{Binding StatusMessage}" TextWrapping="Wrap" Visibility="{Binding StatusMessage, Converter={StaticResource NullToCollapsed}}" />
        </StackPanel>

        <ScrollViewer Margin="0,0,0,24" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,0">
                <ui:Card Padding="24" HorizontalContentAlignment="Stretch" Visibility="{Binding HasItems, Converter={StaticResource InverseBoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Nenhum item de inicialização encontrado" />
                        <TextBlock Margin="0,6,0,0" Style="{StaticResource SecondaryText}" Text="O Windows não informou programas configurados para iniciar com esta conta." TextWrapping="Wrap" />
                    </StackPanel>
                </ui:Card>

                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:Card Style="{StaticResource SectionCard}" Margin="0,0,0,12" Padding="16" HorizontalContentAlignment="Stretch">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.RowSpan="2" Width="40" Height="40" Margin="0,0,12,0">
                                        <Image Width="32" Height="32" Source="{Binding Icon}" Stretch="Uniform" />
                                        <ui:SymbolIcon Width="32" Height="32" FontSize="22" Symbol="AppStore24" Visibility="{Binding Icon, Converter={StaticResource NullToVisible}}" />
                                    </Grid>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Name}" TextWrapping="Wrap" />
                                        <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding Publisher}" />
                                        <TextBlock FontSize="11" Style="{StaticResource SecondaryText}" Text="{Binding Location}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Location}" />
                                        <TextBlock FontSize="11" Style="{StaticResource SecondaryText}" Text="{Binding Command}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Command}" />
                                    </StackPanel>

                                    <WrapPanel Grid.Row="1" Grid.Column="1" Margin="0,12,0,0" VerticalAlignment="Center">
                                        <Border Margin="0,0,12,0" Padding="8,4" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" VerticalAlignment="Center">
                                            <Grid>
                                                <TextBlock FontSize="12" Foreground="{DynamicResource StatusOkBrush}" Text="Ativo — inicia com o Windows" Visibility="{Binding IsEnabled, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock FontSize="12" Style="{StaticResource SecondaryText}" Text="Pendente — não inicia automaticamente" Visibility="{Binding IsEnabled, Converter={StaticResource InverseBoolToVisibility}}" />
                                            </Grid>
                                        </Border>
                                        <ui:Button Margin="0,0,8,0" Padding="6" VerticalAlignment="Center" Appearance="Transparent" AutomationProperties.Name="Abrir local do arquivo" Command="{Binding OpenLocationCommand}" Icon="{ui:SymbolIcon FolderOpen24}" ToolTip="Abrir local do arquivo" />
                                        <ui:Button MinWidth="96" Margin="0,0,8,0" VerticalAlignment="Center" Appearance="Secondary" Command="{Binding ToggleEnabledCommand}" Content="{Binding ActionText}" IsEnabled="{Binding CanToggle}" />
                                        <ui:ToggleSwitch Margin="0,0,4,0" VerticalAlignment="Center" IsChecked="{Binding IsEnabled}" IsEnabled="{Binding CanToggle}" />
                                    </WrapPanel>
                                </Grid>
                            </ui:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
