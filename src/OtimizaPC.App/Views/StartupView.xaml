<UserControl
    x:Class="OtimizaPC.App.Views.StartupView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <DockPanel Margin="28,24,28,0">
        <StackPanel DockPanel.Dock="Top">
            <DockPanel>
                <ui:Button
                    Appearance="Secondary"
                    Command="{Binding RefreshCommand}"
                    Content="Atualizar"
                    DockPanel.Dock="Right"
                    Icon="{ui:SymbolIcon ArrowSync24}" />
                <TextBlock Style="{StaticResource PageTitle}" Text="Inicialização" />
            </DockPanel>
            <TextBlock Style="{StaticResource PageSubtitle}" Text="{Binding Summary}" />
            <TextBlock
                Margin="0,-12,0,12"
                Foreground="{DynamicResource StatusWarningBrush}"
                Text="{Binding StatusMessage}"
                TextWrapping="Wrap"
                Visibility="{Binding StatusMessage, Converter={StaticResource NullToCollapsed}}" />
        </StackPanel>

        <ui:Card
            Margin="0,0,0,24"
            Padding="20,10"
            VerticalAlignment="Stretch"
            VerticalContentAlignment="Stretch">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                    <TextBlock Style="{StaticResource SecondaryText}">
                                        <Run Text="{Binding Publisher, Mode=OneWay}" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding Location, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock
                                        FontSize="11"
                                        Style="{StaticResource SecondaryText}"
                                        Text="{Binding Command}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap"
                                        ToolTip="{Binding Command}" />
                                </StackPanel>
                                <ui:Button
                                    Grid.Column="1"
                                    Margin="0,0,12,0"
                                    Padding="6"
                                    VerticalAlignment="Center"
                                    Appearance="Transparent"
                                    Command="{Binding OpenLocationCommand}"
                                    Icon="{ui:SymbolIcon FolderOpen24}"
                                    ToolTip="Abrir local do arquivo" />
                                <ui:ToggleSwitch
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    IsChecked="{Binding IsEnabled}"
                                    IsEnabled="{Binding CanToggle}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </ui:Card>
    </DockPanel>
</UserControl>
