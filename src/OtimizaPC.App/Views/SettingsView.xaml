<UserControl
    x:Class="OtimizaPC.App.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,28">
            <TextBlock Style="{StaticResource PageTitle}" Text="Configurações" />
            <TextBlock Style="{StaticResource PageSubtitle}" Text="Preferências, atualizações e histórico de alterações." />

            <!-- Aparência -->
            <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                <Border Width="32" Height="32" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="16">
                    <ui:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Symbol="Color24" />
                </Border>
                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource SectionTitle}" Text="Aparência" />
            </StackPanel>
            <ui:Card Style="{StaticResource SettingCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="Tema" />
                        <TextBlock Style="{StaticResource SecondaryText}" Text="Claro, escuro ou acompanhando o Windows." />
                    </StackPanel>
                    <ComboBox
                        Grid.Column="1"
                        Width="220"
                        MinHeight="{DynamicResource ControlMinHeight}"
                        Margin="16,0,0,0"
                        AutomationProperties.HelpText="Escolha entre tema do Windows, claro ou escuro."
                        AutomationProperties.Name="Tema da aplicação"
                        IsTextSearchEnabled="False"
                        ItemsSource="{Binding ThemeOptions}"
                        KeyboardNavigation.TabIndex="0"
                        SelectedIndex="{Binding ThemeIndex}"
                        ToolTip="Tema da aplicação" />
                </Grid>
            </ui:Card>

            <ui:Card Style="{StaticResource SettingCard}">
                <StackPanel>
                    <DockPanel>
                        <ui:ToggleSwitch
                            AutomationProperties.Name="Animações"
                            DockPanel.Dock="Right"
                            IsChecked="{Binding AnimationsEnabled}" />
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="Animações" />
                            <TextBlock Style="{StaticResource SecondaryText}" Text="Transições e entradas suaves, de até 0,3 s. Desligue se o computador estiver lento." />
                            <!-- Estado real: "Animações ativas" ou "Desativadas: motivo" -->
                            <StackPanel Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="{Binding AnimationsStatus}" Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource StatusWarningBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AnimationsActive}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource StatusOkBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding AnimationsStatus}" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                    <Separator Margin="0,12" />
                    <DockPanel>
                        <ui:ToggleSwitch
                            AutomationProperties.HelpText="Ignora o bloqueio por renderização por software. Não ignora o Windows sem animações nem o acesso remoto."
                            AutomationProperties.Name="Forçar animações"
                            DockPanel.Dock="Right"
                            IsChecked="{Binding ForceAnimations}"
                            IsEnabled="{Binding AnimationsEnabled}" />
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="Forçar animações" />
                            <TextBlock Style="{StaticResource SecondaryText}" Text="Liga mesmo em computador sem aceleração gráfica. Não vale com as animações desligadas no Windows nem em acesso remoto." />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </ui:Card>

            <!-- Atualizações -->
            <StackPanel Margin="0,24,0,8" Orientation="Horizontal">
                <Border Width="32" Height="32" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="16">
                    <ui:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Symbol="ArrowSync24" />
                </Border>
                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource SectionTitle}" Text="Atualizações" />
            </StackPanel>
            <ui:Card Style="{StaticResource SettingCard}">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <ui:Button
                                Margin="0,0,8,0"
                                Appearance="Secondary"
                                Command="{Binding CheckUpdatesCommand}"
                                Content="Verificar agora"
                                Icon="{ui:SymbolIcon ArrowSync24}" />
                            <ui:Button
                                Appearance="Primary"
                                Command="{Binding InstallUpdateCommand}"
                                Content="Atualizar agora"
                                Icon="{ui:SymbolIcon ArrowDownload24}"
                                Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="{Binding VersionText}" />
                            <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding UpdateStatus}" />
                        </StackPanel>
                    </DockPanel>
                    <ProgressBar
                        Height="4"
                        Margin="0,10,0,0"
                        Maximum="100"
                        Value="{Binding DownloadProgress}"
                        Visibility="{Binding IsUpdating, Converter={StaticResource BoolToVisibility}}" />
                    <ui:Button
                        Margin="0,8,0,0"
                        Appearance="Transparent"
                        Command="{Binding OpenReleasePageCommand}"
                        Content="Ver novidades desta versão"
                        Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </ui:Card>
            <ui:Card Style="{StaticResource SettingCard}">
                <DockPanel>
                    <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding CheckUpdatesOnStartup}" />
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="Verificar ao abrir o app" />
                        <TextBlock Style="{StaticResource SecondaryText}" Text="Um aviso aparece no topo quando houver versão nova. Também verifica a cada 6 horas." />
                    </StackPanel>
                </DockPanel>
            </ui:Card>
            <ui:Card Style="{StaticResource SettingCard}">
                <DockPanel>
                    <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding AutoInstallUpdates}" />
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="Instalar atualizações automaticamente" />
                        <TextBlock Style="{StaticResource SecondaryText}" Text="A nova versão é baixada em segundo plano e instalada quando você fechar o app." />
                    </StackPanel>
                </DockPanel>
            </ui:Card>
            <ui:Card Style="{StaticResource SettingCard}">
                <DockPanel>
                    <ui:TextBox
                        Width="260"
                        DockPanel.Dock="Right"
                        PlaceholderText="{Binding RepositoryPlaceholder}"
                        Text="{Binding UpdateRepository, UpdateSourceTrigger=LostFocus}" />
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="Repositório de versões (GitHub)" />
                        <TextBlock Style="{StaticResource SecondaryText}" Text="Deixe vazio para usar o repositório oficial. Cada versão deve ter o instalador e o arquivo .sha256 correspondente." />
                    </StackPanel>
                </DockPanel>
            </ui:Card>

            <!-- Automação -->
            <StackPanel Margin="0,24,0,8" Orientation="Horizontal">
                <Border Width="32" Height="32" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="16">
                    <ui:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Symbol="Timer24" />
                </Border>
                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource SectionTitle}" Text="Automação" />
            </StackPanel>
            <ui:Card Style="{StaticResource SettingCard}">
                <DockPanel>
                    <ui:ToggleSwitch
                        DockPanel.Dock="Right"
                        IsChecked="{Binding IsCleanupScheduled}"
                        IsEnabled="{Binding IsAdministrator}" />
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="Limpeza automática semanal" />
                        <TextBlock Style="{StaticResource SecondaryText}" Text="Remove temporários e caches seguros em segundo plano, sem abrir janela." />
                        <TextBlock
                            FontSize="12"
                            Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                            Text="{Binding CleanupStatus}"
                            TextWrapping="Wrap"
                            Visibility="{Binding CleanupStatus, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>
                </DockPanel>
            </ui:Card>

            <!-- Sensores -->
            <StackPanel Margin="0,24,0,8" Orientation="Horizontal">
                <Border Width="32" Height="32" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="16">
                    <ui:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Symbol="Gauge24" />
                </Border>
                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource SectionTitle}" Text="Sensores" />
            </StackPanel>
            <ui:Card Style="{StaticResource SettingCard}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Margin="12,0,0,0">
                        <ui:Button Appearance="Secondary" Command="{Binding SensorSetup.InstallPawnIoCommand}" Content="Instalar driver"
                            Icon="{ui:SymbolIcon ArrowDownload24}"
                            Visibility="{Binding SensorSetup.IsInstalled, Converter={StaticResource InverseBoolToVisibility}}" />
                        <ui:Button Margin="0,6,0,0" Command="{Binding SensorSetup.CheckSensorsCommand}" Content="Verificar sensores" />
                        <ui:Button Margin="0,6,0,0" Command="{Binding SensorSetup.OpenPawnIoWebsiteCommand}" Content="Site oficial do PawnIO" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="Driver PawnIO (temperatura da CPU)" />
                        <TextBlock Style="{StaticResource SecondaryText}">
                            <Run Text="Necessário para ler temperatura e clock do processador. " />
                            <Run Text="{Binding SensorSetup.IsInstalled, Mode=OneWay, Converter={StaticResource PawnIoStatus}}" />
                        </TextBlock>
                        <TextBlock Margin="0,6,0,0" Style="{StaticResource SecondaryText}" Text="{Binding SensorSetup.Status}" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </ui:Card>

            <!-- Histórico -->
            <DockPanel Margin="0,24,0,8">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ui:Button
                        Margin="0,0,8,0"
                        Appearance="Transparent"
                        Command="{Binding OpenDataFolderCommand}"
                        Content="Abrir pasta de dados e logs"
                        Icon="{ui:SymbolIcon FolderOpen24}" />
                    <ui:Button
                        Appearance="Transparent"
                        Command="{Binding LoadHistoryCommand}"
                        AutomationProperties.Name="Atualizar histórico de alterações"
                        Icon="{ui:SymbolIcon ArrowSync24}"
                        ToolTip="Atualizar" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="32" Height="32" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="16">
                        <ui:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Symbol="History24" />
                    </Border>
                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource SectionTitle}" Text="Histórico de alterações" />
                </StackPanel>
            </DockPanel>
            <ui:Card Style="{StaticResource SettingCard}">
                <StackPanel>
                    <TextBlock
                        Style="{StaticResource SecondaryText}"
                        Text="Nenhuma alteração registrada ainda."
                        Visibility="{Binding History.Count, Converter={StaticResource ZeroToVisible}}" />
                    <ItemsControl ItemsSource="{Binding History}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource TableRow}" Margin="0,2" Padding="8,6"><Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding When}" />
                                    <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding Area}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap" />
                                </Grid></Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ui:Card>

            <!-- Sobre -->
            <StackPanel Margin="0,24,0,8" Orientation="Horizontal">
                <Border Width="32" Height="32" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="16">
                    <ui:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Symbol="Info24" />
                </Border>
                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource SectionTitle}" Text="Sobre" />
            </StackPanel>
            <ui:Card Style="{StaticResource SettingCard}">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="{Binding VersionText}" />
                    <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding SystemText}" />
                    <TextBlock Style="{StaticResource SecondaryText}">
                        <Run Text="Dados e logs: " />
                        <Run Text="{Binding DataFolder, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock
                        Margin="0,8,0,0"
                        FontSize="12"
                        Style="{StaticResource SecondaryText}"
                        Text="Usa LibreHardwareMonitor (MPL 2.0), WPF-UI (MIT) e CommunityToolkit.Mvvm (MIT)." />
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
