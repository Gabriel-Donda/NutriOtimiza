<UserControl
    x:Class="OtimizaPC.App.Views.HardwareView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <DockPanel Margin="28,24,28,0">
        <!-- Cabeçalho com ações -->
        <StackPanel DockPanel.Dock="Top">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ui:Button
                        Margin="0,0,8,0"
                        Appearance="Secondary"
                        Command="{Binding RefreshCommand}"
                        Content="Atualizar"
                        Icon="{ui:SymbolIcon ArrowSync24}" />
                    <ui:Button
                        Margin="0,0,8,0"
                        Appearance="Secondary"
                        Command="{Binding CopyTextCommand}"
                        Content="Copiar"
                        Icon="{ui:SymbolIcon Copy24}" />
                    <ui:Button
                        Appearance="Primary"
                        Command="{Binding ExportHtmlCommand}"
                        Content="Exportar relatório"
                        Icon="{ui:SymbolIcon Save24}" />
                </StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="Hardware" />
            </DockPanel>
            <StackPanel Margin="0,4,0,16" Orientation="Horizontal">
                <ui:ProgressRing
                    Width="16"
                    Height="16"
                    Margin="0,0,8,0"
                    IsIndeterminate="True"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding StatusMessage}" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <ItemsControl Margin="0,0,0,28" ItemsSource="{Binding Sections}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:Card
                            Margin="0,0,0,12"
                            Padding="20,16"
                            HorizontalContentAlignment="Stretch">
                            <StackPanel>
                                <StackPanel Margin="0,0,0,6" Orientation="Horizontal">
                                    <ui:SymbolIcon
                                        FontSize="22"
                                        Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                        Symbol="{Binding Icon, Converter={StaticResource StringToSymbol}}" />
                                    <TextBlock
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SectionTitle}"
                                        Text="{Binding Title}" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Groups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,6,0,4">
                                                <TextBlock
                                                    Margin="0,6,0,4"
                                                    FontWeight="SemiBold"
                                                    Text="{Binding Header}"
                                                    Visibility="{Binding Header, Converter={StaticResource NullToCollapsed}}" />
                                                <ItemsControl ItemTemplate="{StaticResource InfoEntryTemplate}" ItemsSource="{Binding Entries}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
