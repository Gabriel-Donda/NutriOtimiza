<UserControl
    x:Class="OtimizaPC.App.Views.HardwareView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:motion="clr-namespace:OtimizaPC.App.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <DockPanel Margin="28,24,28,0">
        <!-- Cabeçalho com ações -->
        <StackPanel DockPanel.Dock="Top">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ui:Button
                        Margin="0,0,8,0"
                        Appearance="Secondary"
                        Command="{Binding CollapseAllCommand}"
                        Content="Recolher tudo" />
                    <ui:Button
                        Margin="0,0,8,0"
                        Appearance="Secondary"
                        Command="{Binding ExpandAllCommand}"
                        Content="Expandir tudo" />
                    <ui:Button
                        Margin="0,0,8,0"
                        Appearance="Secondary"
                        Command="{Binding RefreshCommand}"
                        Content="Atualizar"
                        Icon="{ui:SymbolIcon ArrowSync24}" />
                    <ui:Button
                        Margin="0,0,8,0"
                        Appearance="Secondary"
                        Command="{Binding CopyTextCommand}"
                        Content="Copiar"
                        Icon="{ui:SymbolIcon Copy24}" />
                    <ui:Button
                        Appearance="Primary"
                        Command="{Binding ExportHtmlCommand}"
                        Content="Exportar relatório"
                        Icon="{ui:SymbolIcon Save24}" />
                </StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="Hardware" />
            </DockPanel>
            <StackPanel Margin="0,4,0,16" Orientation="Horizontal">
                <ui:ProgressRing
                    Width="16"
                    Height="16"
                    Margin="0,0,8,0"
                    IsIndeterminate="True"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding StatusMessage}" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <ItemsControl Margin="0,0,0,28" ItemsSource="{Binding Sections}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:Card
                            Style="{StaticResource SectionCard}"
                            Margin="0,0,0,12"
                            Padding="20,16"
                            HorizontalContentAlignment="Stretch">
                            <StackPanel>
                                <Button
                                    Padding="4"
                                    HorizontalContentAlignment="Stretch"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    FocusVisualStyle="{StaticResource AppFocusVisualStyle}"
                                    Command="{Binding DataContext.ToggleSectionCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                    CommandParameter="{Binding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon
                                            FontSize="22"
                                            Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                            Symbol="{Binding Icon, Converter={StaticResource StringToSymbol}}" />
                                        <StackPanel Grid.Column="1" Margin="10,0,10,0">
                                            <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding Summary}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <!-- Chevron gira 180° com animação ao expandir/recolher -->
                                        <ui:SymbolIcon
                                            Grid.Column="2"
                                            FontSize="20"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Symbol="ChevronDown24"
                                            motion:MotionBehaviors.ChevronExpanded="{Binding IsExpanded}" />
                                    </Grid>
                                </Button>
                                <!-- Recolher/expandir com altura e opacidade animadas (ver MotionBehaviors.Expanded) -->
                                <Border ClipToBounds="True" motion:MotionBehaviors.Expanded="{Binding IsExpanded}">
                                    <ItemsControl ItemsSource="{Binding Groups}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,6,0,4">
                                                    <TextBlock
                                                        Margin="0,6,0,4"
                                                        FontWeight="SemiBold"
                                                        Text="{Binding Header}"
                                                        Visibility="{Binding Header, Converter={StaticResource NullToCollapsed}}" />
                                                    <ItemsControl ItemTemplate="{StaticResource InfoEntryTemplate}" ItemsSource="{Binding Entries}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
