<UserControl
    x:Class="OtimizaPC.App.Views.OptimizationsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <DockPanel Margin="28,24,28,0">
        <!-- Cabeçalho -->
        <StackPanel DockPanel.Dock="Top">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ui:Button
                        Margin="0,0,8,0"
                        Appearance="Secondary"
                        Command="{Binding SelectRecommendedCommand}"
                        Content="Recomendados"
                        Icon="{ui:SymbolIcon Star24}" />
                    <ui:Button
                        Margin="0,0,8,0"
                        Appearance="Secondary"
                        Command="{Binding DiscardCommand}"
                        Content="Descartar"
                        Icon="{ui:SymbolIcon ArrowUndo24}" />
                    <ui:Button
                        Appearance="Primary"
                        Command="{Binding ApplyCommand}"
                        Content="{Binding ApplyText}"
                        Icon="{ui:SymbolIcon Flash24}" />
                </StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="Otimizações" />
            </DockPanel>
            <TextBlock Style="{StaticResource PageSubtitle}" Text="Ajustes curados e reversíveis. Ligue ou desligue e clique em Aplicar." />

            <DockPanel Margin="0,0,0,12">
                <ui:Button
                    Margin="12,0,0,0"
                    Appearance="Caution"
                    Command="{Binding RestartExplorerCommand}"
                    Content="Reiniciar Explorador agora"
                    DockPanel.Dock="Right"
                    Icon="{ui:SymbolIcon ArrowSync24}"
                    Visibility="{Binding NeedsExplorerRestart, Converter={StaticResource BoolToVisibility}}" />
                <CheckBox
                    Content="Criar ponto de restauração antes de aplicar"
                    DockPanel.Dock="Left"
                    IsChecked="{Binding CreateRestorePoint}"
                    IsEnabled="{Binding CanCreateRestorePoint}" />
                <TextBlock
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource SecondaryText}"
                    Text="{Binding StatusMessage}" />
            </DockPanel>
            <ProgressBar
                Height="4"
                Margin="0,0,0,12"
                IsIndeterminate="True"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <ItemsControl Margin="0,0,0,28" ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:Card
                            Margin="0,0,0,12"
                            Padding="20,14"
                            HorizontalContentAlignment="Stretch">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,8"
                                    Style="{StaticResource SectionTitle}"
                                    Text="{Binding Name}" />
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,8" IsEnabled="{Binding IsEnabled}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,16,0">
                                                    <WrapPanel>
                                                        <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                                        <Border
                                                            Background="{DynamicResource StatusWarningBrush}"
                                                            Style="{StaticResource Badge}"
                                                            Visibility="{Binding IsModerate, Converter={StaticResource BoolToVisibility}}">
                                                            <TextBlock
                                                                FontSize="11"
                                                                Foreground="{DynamicResource StatusWarningOnFillBrush}"
                                                                Text="Efeito colateral" />
                                                        </Border>
                                                        <Border
                                                            Background="{DynamicResource StatusCriticalBrush}"
                                                            Style="{StaticResource Badge}"
                                                            Visibility="{Binding IsAdvanced, Converter={StaticResource BoolToVisibility}}">
                                                            <TextBlock
                                                                FontSize="11"
                                                                Foreground="{DynamicResource StatusCriticalOnFillBrush}"
                                                                Text="Avançado" />
                                                        </Border>
                                                        <Border
                                                            BorderBrush="{DynamicResource StatusInfoBrush}"
                                                            BorderThickness="1"
                                                            Style="{StaticResource Badge}"
                                                            Visibility="{Binding RestartText, Converter={StaticResource NullToCollapsed}}">
                                                            <TextBlock
                                                                FontSize="11"
                                                                Foreground="{DynamicResource StatusInfoBrush}"
                                                                Text="{Binding RestartText}" />
                                                        </Border>
                                                        <Border
                                                            BorderBrush="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                            BorderThickness="1"
                                                            Style="{StaticResource Badge}"
                                                            Visibility="{Binding IsPending, Converter={StaticResource BoolToVisibility}}">
                                                            <TextBlock
                                                                FontSize="11"
                                                                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                                Text="Alteração pendente" />
                                                        </Border>
                                                    </WrapPanel>
                                                    <TextBlock
                                                        Margin="0,2,0,0"
                                                        Style="{StaticResource SecondaryText}"
                                                        Text="{Binding Description}" />
                                                    <TextBlock
                                                        Margin="0,2,0,0"
                                                        FontSize="12"
                                                        Text="{Binding StatusText}"
                                                        TextWrapping="Wrap"
                                                        Visibility="{Binding StatusText, Converter={StaticResource NullToCollapsed}}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource StatusOkBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource StatusCriticalBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                                <ui:ToggleSwitch
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    IsChecked="{Binding IsOn}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
