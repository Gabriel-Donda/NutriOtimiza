<UserControl
    x:Class="OtimizaPC.App.Views.DashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:OtimizaPC.App.Controls"
    xmlns:models="clr-namespace:OtimizaPC.Core.Models;assembly=OtimizaPC.Core"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        KeyboardNavigation.TabNavigation="Local"
        VerticalScrollBarVisibility="Auto">
        <Grid Width="{Binding RelativeSource={RelativeSource AncestorType=ScrollViewer}, Path=ViewportWidth}">
            <StackPanel Margin="28,24,28,28">
            <TextBlock Style="{StaticResource PageTitle}" Text="Painel" />
            <TextBlock Style="{StaticResource PageSubtitle}" Text="Visão geral do computador em tempo real" />
            <TextBlock
                Margin="0,-12,0,12"
                Style="{StaticResource SecondaryText}"
                Text="{Binding LastMetricsUpdatedText}"
                Visibility="{Binding LastMetricsUpdatedText, Converter={StaticResource NullToCollapsed}}" />

            <ui:InfoBar
                Title="Sensores"
                Margin="0,0,0,16"
                IsClosable="False"
                IsOpen="{Binding HasSensorMessage, Mode=OneWay}"
                Message="{Binding SensorMessage}"
                Severity="Warning">
                <StackPanel>
                    <TextBlock Margin="0,4,0,8" Text="{Binding SensorSetup.Status}" TextWrapping="Wrap"
                        Visibility="{Binding SensorSetup.Status, Converter={StaticResource NullToCollapsed}}" />
                    <WrapPanel>
                        <ui:Button Margin="0,0,8,4" Command="{Binding SensorSetup.InstallPawnIoCommand}" Content="Instalar PawnIO"
                            Visibility="{Binding SensorSetup.IsInstalled, Converter={StaticResource InverseBoolToVisibility}}" />
                        <ui:Button Margin="0,0,8,4" Command="{Binding SensorSetup.CheckSensorsCommand}" Content="Verificar sensores" />
                        <ui:Button Margin="0,0,0,4" Command="{Binding SensorSetup.OpenPawnIoWebsiteCommand}" Content="Site oficial do PawnIO"
                            Visibility="{Binding SensorSetup.IsInstalled, Converter={StaticResource InverseBoolToVisibility}}" />
                    </WrapPanel>
                </StackPanel>
            </ui:InfoBar>

            <Border
                Margin="0,0,0,16"
                Padding="12,10"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Visibility="{Binding IsCheckingHealth, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <ui:ProgressRing
                        Width="20"
                        Height="20"
                        Margin="0,0,10,0"
                        IsIndeterminate="True" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource SecondaryText}"
                        Text="Verificando a saúde do sistema…" />
                </StackPanel>
            </Border>

            <!-- Cartões de métricas -->
            <ItemsControl HorizontalContentAlignment="Stretch" Margin="0,0,-12,0" ItemsSource="{Binding Cards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button
                            AutomationProperties.Name="{Binding Title}"
                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding Destination}"
                            Style="{StaticResource DashboardMetricButton}"
                            ToolTip="{Binding Tooltip}"
                            Margin="0,0,12,12"
                            VerticalAlignment="Stretch"
                            VerticalContentAlignment="Stretch">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon
                                        FontSize="18"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Symbol="{Binding Icon}" />
                                    <TextBlock
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SecondaryText}"
                                        Text="{Binding Title}" />
                                </StackPanel>
                                <TextBlock
                                    Grid.Row="1"
                                    Margin="0,8,0,0"
                                    FontSize="28"
                                    FontWeight="SemiBold"
                                    Text="{Binding Value}"
                                    TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:HealthStatus.Warning}">
                                                    <Setter Property="Foreground" Value="{DynamicResource StatusWarningBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:HealthStatus.Critical}">
                                                    <Setter Property="Foreground" Value="{DynamicResource StatusCriticalBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock
                                    Grid.Row="2"
                                    Margin="0,2,0,0"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{Binding Detail}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="{Binding Detail}" />
                                <controls:Sparkline
                                    Grid.Row="3"
                                    Height="44"
                                    Margin="0,12,0,0"
                                    VerticalAlignment="Bottom"
                                    Maximum="{Binding Maximum}"
                                    Stroke="{DynamicResource AccentFillColorDefaultBrush}"
                                    Values="{Binding History}"
                                    Visibility="{Binding ShowChart, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Visualizações adicionais: temperaturas, rede e espaço por disco. -->
            <ItemsControl HorizontalContentAlignment="Stretch" Margin="0,0,0,4">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.Items>
                    <ui:Card
                        Style="{StaticResource SectionCard}"
                        MinWidth="{DynamicResource DashboardPanelMinWidth}"
                        Margin="0,0,12,12"
                        AutomationProperties.Name="Temperaturas do sistema"
                        Visibility="{Binding HasTemperature, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Temperaturas" />
                            <TextBlock Style="{StaticResource SecondaryText}" Text="Leitura atual dos principais componentes." />
                            <Grid Margin="0,14,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontWeight="SemiBold" Text="CPU" />
                                <ProgressBar Grid.Column="1" Height="8" Margin="12,0" Maximum="100" Value="{Binding CpuTemperature, Mode=OneWay}" />
                                <TextBlock Grid.Column="2" Foreground="{Binding TemperatureStatus, Converter={StaticResource StatusToBrush}}" Text="{Binding CpuTemperatureText}" />
                                <TextBlock Grid.Row="1" Margin="0,10,0,0" FontWeight="SemiBold" Text="GPU" />
                                <ProgressBar Grid.Row="1" Grid.Column="1" Height="8" Margin="12,10,12,0" Maximum="100" Value="{Binding GpuTemperature, Mode=OneWay}" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Margin="0,10,0,0" Foreground="{Binding TemperatureStatus, Converter={StaticResource StatusToBrush}}" Text="{Binding GpuTemperatureText}" />
                            </Grid>
                        </StackPanel>
                    </ui:Card>

                    <ui:Card
                        Style="{StaticResource SectionCard}"
                        MinWidth="{DynamicResource DashboardPanelMinWidth}"
                        Margin="0,0,12,12"
                        AutomationProperties.Name="Histórico de rede">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Rede" />
                            <TextBlock Style="{StaticResource SecondaryText}" Text="Tráfego recente de download e upload." />
                            <controls:Sparkline
                                Height="48"
                                Margin="0,14,0,4"
                                Maximum="{Binding NetworkHistoryMaximum}"
                                Stroke="{DynamicResource StatusInfoBrush}"
                                Values="{Binding NetworkDownloadHistory}" />
                            <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding NetworkDownloadText}" />
                            <controls:Sparkline
                                Height="48"
                                Margin="0,8,0,4"
                                Maximum="{Binding NetworkHistoryMaximum}"
                                Stroke="{DynamicResource BrandOrangeBrush}"
                                Values="{Binding NetworkUploadHistory}" />
                            <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding NetworkUploadText}" />
                        </StackPanel>
                    </ui:Card>

                    <ui:Card
                        Style="{StaticResource SectionCard}"
                        MinWidth="{DynamicResource DashboardPanelMinWidth}"
                        Margin="0,0,0,12"
                        AutomationProperties.Name="Uso dos discos">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Uso dos discos" />
                            <TextBlock Style="{StaticResource SecondaryText}" Text="Espaço usado por unidade." />
                            <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Disks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,5">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}" />
                                            <ProgressBar Grid.Row="1" Height="7" Margin="0,4,0,0" Maximum="100" Value="{Binding UsedPercent, Mode=OneWay}" ToolTip="{Binding UsedText}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ui:Card>
                </ItemsControl.Items>
            </ItemsControl>

            <!-- Uso por núcleo e processos com maior consumo. -->
            <ItemsControl HorizontalContentAlignment="Stretch" Margin="0,0,0,4">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.Items>
                    <ui:Card
                        Style="{StaticResource SectionCard}"
                        MinWidth="{DynamicResource DashboardPanelMinWidth}"
                        Margin="0,0,12,12"
                        AutomationProperties.Name="Uso por núcleo do processador">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Uso por núcleo" />
                            <TextBlock Style="{StaticResource SecondaryText}" Text="Carga de cada processador lógico." />
                            <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding CpuCores}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="48" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontSize="12" Style="{StaticResource SecondaryText}" Text="{Binding Label}" />
                                            <ProgressBar
                                                Grid.Column="1"
                                                Height="7"
                                                Margin="8,0"
                                                Maximum="100"
                                                Value="{Binding Usage, Mode=OneWay}"
                                                Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}" />
                                            <TextBlock Grid.Column="2" Margin="0,0,4,0" FontSize="11" Text="{Binding UsageText}" TextAlignment="Right" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ui:Card>

                    <ui:Card
                        Style="{StaticResource SectionCard}"
                        MinWidth="{DynamicResource DashboardPanelMinWidth}"
                        Margin="0,0,0,12"
                        AutomationProperties.Name="Processos com maior consumo">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Processos em destaque" />
                            <TextBlock Style="{StaticResource SecondaryText}" Text="Top 5 por CPU e memória." />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="CPU" />
                                    <ItemsControl ItemsSource="{Binding TopProcessesByCpu}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                                    <TextBlock Grid.Column="1" Margin="6,0,0,0" Style="{StaticResource SecondaryText}" Text="{Binding CpuText}" TextAlignment="Right" TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock FontWeight="SemiBold" Text="Memória" />
                                    <ItemsControl ItemsSource="{Binding TopProcessesByMemory}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                                    <TextBlock Grid.Column="1" Margin="6,0,0,0" Style="{StaticResource SecondaryText}" Text="{Binding MemoryText}" TextAlignment="Right" TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ui:Card>
                </ItemsControl.Items>
            </ItemsControl>

            <ItemsControl HorizontalContentAlignment="Stretch" Margin="0,4,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.Items>
                <!-- Saúde do sistema -->
                <ui:Card
                    Style="{StaticResource SectionCard}"
                    MinWidth="{DynamicResource DashboardPanelMinWidth}"
                    Margin="0,0,12,12"
                    VerticalAlignment="Stretch"
                    VerticalContentAlignment="Top">
                    <StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Saúde do sistema" />
                            <WrapPanel Margin="0,8,0,0">
                                <ui:Button
                                    Margin="0,0,8,0"
                                    Appearance="Transparent"
                                    Command="{Binding ToggleHealthDetailsCommand}"
                                    Content="Detalhes"
                                    ToolTip="Mostrar ou ocultar detalhes da saúde" />
                                <ui:Button
                                    Appearance="Secondary"
                                    Command="{Binding RunHealthCheckCommand}"
                                    Content="Verificar novamente"
                                    Icon="{ui:SymbolIcon ArrowSync24}" />
                            </WrapPanel>
                        </StackPanel>
                        <TextBlock
                            Margin="0,2,0,0"
                            Style="{StaticResource SecondaryText}"
                            Text="{Binding HealthUpdatedText}"
                            Visibility="{Binding HealthUpdatedText, Converter={StaticResource NullToCollapsed}}" />

                        <StackPanel Margin="0,14,0,10" Orientation="Horizontal">
                            <TextBlock
                                FontSize="44"
                                FontWeight="Bold"
                                Foreground="{Binding ScoreStatus, Converter={StaticResource StatusToBrush}}"
                                Text="{Binding Score}" />
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SecondaryText}" Text="de 100" />
                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding ScoreLabel}" />
                            </StackPanel>
                            <ui:ProgressRing
                                Width="24"
                                Height="24"
                                Margin="16,0,0,0"
                                IsIndeterminate="True"
                                Visibility="{Binding IsCheckingHealth, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                        <ProgressBar
                            Height="8"
                            Margin="0,0,0,12"
                            Maximum="100"
                            Value="{Binding Score, Mode=OneWay}"
                            ToolTip="Pontuação de saúde do sistema" />

                        <StackPanel Visibility="{Binding AreHealthDetailsVisible, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl ItemsSource="{Binding Checks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon
                                            Margin="0,1,12,0"
                                            VerticalAlignment="Top"
                                            FontSize="20"
                                            Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}"
                                            Symbol="{Binding Status, Converter={StaticResource StatusToSymbol}}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                            <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding Detail}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock
                            Margin="0,8,0,0"
                            Style="{StaticResource SecondaryText}"
                            Text="Nenhuma verificação disponível ainda."
                            TextWrapping="Wrap"
                            Visibility="{Binding Checks.Count, Converter={StaticResource ZeroToVisible}}" />
                        <TextBlock
                            Margin="0,8,0,0"
                            Foreground="{DynamicResource StatusCriticalForegroundBrush}"
                            Text="Não foi possível concluir a verificação. Tente novamente."
                            TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ScoreLabel}" Value="Erro na verificação">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </ui:Card>

                <!-- Resumo do sistema -->
                <ui:Card
                    Style="{StaticResource SectionCard}"
                    MinWidth="{DynamicResource DashboardPanelMinWidth}"
                    Margin="0,0,0,12"
                    MinHeight="260"
                    VerticalAlignment="Stretch"
                    VerticalContentAlignment="Top">
                    <StackPanel>
                        <DockPanel Margin="0,4,0,14">
                            <ui:ProgressRing
                                Width="18"
                                Height="18"
                                Margin="8,0,0,0"
                                DockPanel.Dock="Right"
                                IsIndeterminate="True"
                                Visibility="{Binding IsSummaryLoading, Converter={StaticResource BoolToVisibility}}" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Resumo do computador" />
                                <TextBlock
                                    Style="{StaticResource SecondaryText}"
                                    Text="{Binding SummaryUpdatedText}"
                                    Visibility="{Binding SummaryUpdatedText, Converter={StaticResource NullToCollapsed}}" />
                            </StackPanel>
                        </DockPanel>
                        <ItemsControl ItemTemplate="{StaticResource InfoEntryTemplate}" ItemsSource="{Binding Summary}" />
                    </StackPanel>
                </ui:Card>
                </ItemsControl.Items>
            </ItemsControl>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
