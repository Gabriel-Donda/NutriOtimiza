<UserControl
    x:Class="OtimizaPC.App.Views.DashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:OtimizaPC.App.Controls"
    xmlns:models="clr-namespace:OtimizaPC.Core.Models;assembly=OtimizaPC.Core"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        KeyboardNavigation.TabNavigation="Local"
        VerticalScrollBarVisibility="Auto">
        <Grid Width="{Binding RelativeSource={RelativeSource AncestorType=ScrollViewer}, Path=ViewportWidth}">
            <StackPanel Margin="28,24,28,32">
                <TextBlock Style="{StaticResource PageTitle}" Text="Painel" />
                <TextBlock Style="{StaticResource PageSubtitle}" Text="Visão geral do computador em tempo real" />
                <TextBlock
                    Margin="0,-12,0,16"
                    FontSize="12"
                    Style="{StaticResource SecondaryText}"
                    Text="{Binding LastMetricsUpdatedText}"
                    Visibility="{Binding LastMetricsUpdatedText, Converter={StaticResource NullToCollapsed}}" />

                <ui:InfoBar
                    Title="Sensores"
                    Margin="0,0,0,16"
                    IsClosable="False"
                    IsOpen="{Binding HasSensorMessage, Mode=OneWay}"
                    Message="{Binding SensorMessage}"
                    Severity="Warning">
                    <StackPanel>
                        <TextBlock
                            Margin="0,4,0,8"
                            Text="{Binding SensorSetup.Status}"
                            TextWrapping="Wrap"
                            Visibility="{Binding SensorSetup.Status, Converter={StaticResource NullToCollapsed}}" />
                        <WrapPanel>
                            <ui:Button Margin="0,0,8,4" Command="{Binding SensorSetup.InstallPawnIoCommand}" Content="Instalar PawnIO"
                                Visibility="{Binding SensorSetup.IsInstalled, Converter={StaticResource InverseBoolToVisibility}}" />
                            <ui:Button Margin="0,0,8,4" Command="{Binding SensorSetup.CheckSensorsCommand}" Content="Verificar sensores" />
                            <ui:Button Margin="0,0,0,4" Command="{Binding SensorSetup.OpenPawnIoWebsiteCommand}" Content="Site oficial do PawnIO"
                                Visibility="{Binding SensorSetup.IsInstalled, Converter={StaticResource InverseBoolToVisibility}}" />
                        </WrapPanel>
                    </StackPanel>
                </ui:InfoBar>

                <Border
                    Margin="0,0,0,16"
                    Padding="16,12"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{Binding IsCheckingHealth, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <ui:ProgressRing
                            Width="20"
                            Height="20"
                            Margin="0,0,12,0"
                            IsIndeterminate="True" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource SecondaryText}"
                            Text="Verificando a saúde do sistema…" />
                    </StackPanel>
                </Border>

                <!-- Cartões de métricas: número grande e rótulo secundário -->
                <ItemsControl Margin="0,0,-12,0" HorizontalContentAlignment="Stretch" ItemsSource="{Binding Cards}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button
                                Margin="0,0,12,12"
                                VerticalAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                AutomationProperties.Name="{Binding Title}"
                                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding Destination}"
                                Style="{StaticResource DashboardMetricButton}"
                                ToolTip="{Binding Tooltip}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <DockPanel>
                                        <Border
                                            Width="32"
                                            Height="32"
                                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                                            CornerRadius="16"
                                            DockPanel.Dock="Left">
                                            <ui:SymbolIcon
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="16"
                                                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                Symbol="{Binding Icon}" />
                                        </Border>
                                        <TextBlock
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Style="{StaticResource SecondaryText}"
                                            Text="{Binding Title}"
                                            TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                    <TextBlock
                                        Grid.Row="1"
                                        Margin="0,12,0,0"
                                        controls:MotionBehaviors.PulseOnChange="True"
                                        FontSize="32"
                                        FontWeight="SemiBold"
                                        Text="{Binding Value}"
                                        TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static models:HealthStatus.Warning}">
                                                        <Setter Property="Foreground" Value="{DynamicResource StatusWarningBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static models:HealthStatus.Critical}">
                                                        <Setter Property="Foreground" Value="{DynamicResource StatusCriticalBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock
                                        Grid.Row="2"
                                        Margin="0,4,0,0"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding Detail}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding Detail}" />
                                    <controls:Sparkline
                                        Grid.Row="3"
                                        Height="40"
                                        Margin="0,12,0,0"
                                        VerticalAlignment="Bottom"
                                        Maximum="{Binding Maximum}"
                                        Stroke="{DynamicResource AccentFillColorDefaultBrush}"
                                        Values="{Binding History}"
                                        Visibility="{Binding ShowChart, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Temperaturas, rede e espaço por disco -->
                <ItemsControl Margin="0,8,0,0" HorizontalContentAlignment="Stretch">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.Items>
                        <ui:Card
                            Margin="0,0,12,12"
                            Padding="20,16"
                            AutomationProperties.Name="Temperaturas do sistema"
                            HorizontalContentAlignment="Stretch"
                            Style="{StaticResource SectionCard}"
                            Visibility="{Binding HasTemperature, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="20">
                                        <ui:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Symbol="Temperature24" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="Temperaturas" />
                                        <TextBlock Style="{StaticResource SecondaryText}" Text="Leitura atual dos principais componentes." />
                                    </StackPanel>
                                </Grid>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="CPU" />
                                    <ProgressBar Grid.Column="1" Height="8" Margin="8,0,12,0" VerticalAlignment="Center" Maximum="100" controls:MotionBehaviors.AnimatedValue="{Binding CpuTemperature, Mode=OneWay}" Foreground="{Binding TemperatureStatus, Converter={StaticResource StatusToBrush}}" />
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{Binding TemperatureStatus, Converter={StaticResource StatusToBrush}}" Text="{Binding CpuTemperatureText}" />
                                    <TextBlock Grid.Row="1" Margin="0,14,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="GPU" />
                                    <ProgressBar Grid.Row="1" Grid.Column="1" Height="8" Margin="8,14,12,0" VerticalAlignment="Center" Maximum="100" controls:MotionBehaviors.AnimatedValue="{Binding GpuTemperature, Mode=OneWay}" Foreground="{Binding TemperatureStatus, Converter={StaticResource StatusToBrush}}" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Margin="0,14,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{Binding TemperatureStatus, Converter={StaticResource StatusToBrush}}" Text="{Binding GpuTemperatureText}" />
                                </Grid>
                            </StackPanel>
                        </ui:Card>

                        <ui:Card
                            Margin="0,0,12,12"
                            Padding="20,16"
                            AutomationProperties.Name="Histórico de rede"
                            HorizontalContentAlignment="Stretch"
                            Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="20">
                                        <ui:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Symbol="Wifi124" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="Rede" />
                                        <TextBlock Style="{StaticResource SecondaryText}" Text="Tráfego recente de download e upload." />
                                    </StackPanel>
                                </Grid>
                                <controls:Sparkline
                                    Height="48"
                                    Margin="0,0,0,4"
                                    Maximum="{Binding NetworkHistoryMaximum}"
                                    Stroke="{DynamicResource StatusInfoBrush}"
                                    Values="{Binding NetworkDownloadHistory}" />
                                <TextBlock FontSize="12" Style="{StaticResource SecondaryText}" Text="{Binding NetworkDownloadText}" />
                                <controls:Sparkline
                                    Height="48"
                                    Margin="0,12,0,4"
                                    Maximum="{Binding NetworkHistoryMaximum}"
                                    Stroke="{DynamicResource BrandOrangeBrush}"
                                    Values="{Binding NetworkUploadHistory}" />
                                <TextBlock FontSize="12" Style="{StaticResource SecondaryText}" Text="{Binding NetworkUploadText}" />
                            </StackPanel>
                        </ui:Card>

                        <ui:Card
                            Margin="0,0,0,12"
                            Padding="20,16"
                            AutomationProperties.Name="Uso dos discos"
                            HorizontalContentAlignment="Stretch"
                            Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="20">
                                        <ui:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Symbol="HardDrive24" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="Uso dos discos" />
                                        <TextBlock Style="{StaticResource SecondaryText}" Text="Espaço usado por unidade." />
                                    </StackPanel>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Disks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,6">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}" />
                                                <ProgressBar
                                                    Grid.Row="1"
                                                    Height="8"
                                                    Margin="0,6,0,0"
                                                    Maximum="100"
                                                    controls:MotionBehaviors.AnimatedValue="{Binding UsedPercent, Mode=OneWay}"
                                                    Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}"
                                                    ToolTip="{Binding UsedText}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ui:Card>
                    </ItemsControl.Items>
                </ItemsControl>

                <!-- Uso por núcleo e processos com maior consumo -->
                <ItemsControl Margin="0,0,0,0" HorizontalContentAlignment="Stretch">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.Items>
                        <ui:Card
                            Margin="0,0,12,12"
                            Padding="20,16"
                            AutomationProperties.Name="Uso por núcleo do processador"
                            HorizontalContentAlignment="Stretch"
                            Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="20">
                                        <ui:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Symbol="DeveloperBoard24" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="Uso por núcleo" />
                                        <TextBlock Style="{StaticResource SecondaryText}" Text="Carga de cada processador lógico." />
                                    </StackPanel>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding CpuCores}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="48" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Center" FontSize="12" Style="{StaticResource SecondaryText}" Text="{Binding Label}" />
                                                <ProgressBar
                                                    Grid.Column="1"
                                                    Height="8"
                                                    Margin="8,0"
                                                    VerticalAlignment="Center"
                                                    Maximum="100"
                                                    controls:MotionBehaviors.AnimatedValue="{Binding Usage, Mode=OneWay}"
                                                    Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}" />
                                                <TextBlock Grid.Column="2" Width="56" VerticalAlignment="Center" FontSize="12" Text="{Binding UsageText}" TextAlignment="Right" TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ui:Card>

                        <ui:Card
                            Margin="0,0,0,12"
                            Padding="20,16"
                            AutomationProperties.Name="Processos com maior consumo"
                            HorizontalContentAlignment="Stretch"
                            Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="20">
                                        <ui:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Symbol="Apps24" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="Processos em destaque" />
                                        <TextBlock Style="{StaticResource SecondaryText}" Text="Top 5 por CPU e memória." />
                                    </StackPanel>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Margin="0,0,0,4" FontSize="12" FontWeight="SemiBold" Style="{StaticResource SecondaryText}" Text="CPU" />
                                        <ItemsControl ItemsSource="{Binding TopProcessesByCpu}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                                        <TextBlock Grid.Column="1" Margin="8,0,0,0" FontWeight="SemiBold" Style="{StaticResource SecondaryText}" Text="{Binding CpuText}" TextAlignment="Right" TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Margin="0,0,0,4" FontSize="12" FontWeight="SemiBold" Style="{StaticResource SecondaryText}" Text="Memória" />
                                        <ItemsControl ItemsSource="{Binding TopProcessesByMemory}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                                        <TextBlock Grid.Column="1" Margin="8,0,0,0" FontWeight="SemiBold" Style="{StaticResource SecondaryText}" Text="{Binding MemoryText}" TextAlignment="Right" TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ui:Card>
                    </ItemsControl.Items>
                </ItemsControl>

                <!-- Saúde do sistema e resumo do computador -->
                <ItemsControl Margin="0,0,0,0" HorizontalContentAlignment="Stretch">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.Items>
                        <!-- Saúde do sistema -->
                        <ui:Card
                            Margin="0,0,12,12"
                            Padding="20,16"
                            VerticalAlignment="Stretch"
                            VerticalContentAlignment="Top"
                            HorizontalContentAlignment="Stretch"
                            Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="20">
                                        <ui:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Symbol="Shield24" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="Saúde do sistema" />
                                        <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding HealthUpdatedText}" Visibility="{Binding HealthUpdatedText, Converter={StaticResource NullToCollapsed}}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:Button
                                            Margin="0,0,8,0"
                                            Appearance="Transparent"
                                            Command="{Binding ToggleHealthDetailsCommand}"
                                            Content="Detalhes"
                                            ToolTip="Mostrar ou ocultar detalhes da saúde" />
                                        <ui:Button
                                            Appearance="Secondary"
                                            Command="{Binding RunHealthCheckCommand}"
                                            Content="Verificar novamente"
                                            Icon="{ui:SymbolIcon ArrowSync24}" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        FontSize="48"
                                        FontWeight="Bold"
                                        Foreground="{Binding ScoreStatus, Converter={StaticResource StatusToBrush}}"
                                        Text="{Binding Score}" />
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Bottom">
                                        <TextBlock Style="{StaticResource SecondaryText}" Text="de 100" />
                                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding ScoreLabel}" />
                                    </StackPanel>
                                    <ui:ProgressRing
                                        Width="24"
                                        Height="24"
                                        Margin="16,0,0,0"
                                        VerticalAlignment="Center"
                                        IsIndeterminate="True"
                                        Visibility="{Binding IsCheckingHealth, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                                <ProgressBar
                                    Height="8"
                                    Margin="0,12,0,0"
                                    Maximum="100"
                                    controls:MotionBehaviors.AnimatedValue="{Binding Score, Mode=OneWay}"
                                    Foreground="{Binding ScoreStatus, Converter={StaticResource StatusToBrush}}"
                                    ToolTip="Pontuação de saúde do sistema" />

                                <StackPanel Margin="0,8,0,0" Visibility="{Binding AreHealthDetailsVisible, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl ItemsSource="{Binding Checks}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <ui:SymbolIcon
                                                        Margin="0,1,12,0"
                                                        VerticalAlignment="Top"
                                                        FontSize="20"
                                                        Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}"
                                                        Symbol="{Binding Status, Converter={StaticResource StatusToSymbol}}" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                                        <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding Detail}" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock
                                        Margin="0,8,0,0"
                                        Style="{StaticResource SecondaryText}"
                                        Text="Nenhuma verificação disponível ainda."
                                        TextWrapping="Wrap"
                                        Visibility="{Binding Checks.Count, Converter={StaticResource ZeroToVisible}}" />
                                    <TextBlock
                                        Margin="0,8,0,0"
                                        Foreground="{DynamicResource StatusCriticalForegroundBrush}"
                                        Text="Não foi possível concluir a verificação. Tente novamente."
                                        TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ScoreLabel}" Value="Erro na verificação">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </ui:Card>

                        <!-- Resumo do sistema -->
                        <ui:Card
                            Margin="0,0,0,12"
                            Padding="20,16"
                            VerticalAlignment="Stretch"
                            VerticalContentAlignment="Top"
                            HorizontalContentAlignment="Stretch"
                            Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="20">
                                        <ui:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Symbol="Desktop24" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="Resumo do computador" />
                                        <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding SummaryUpdatedText}" Visibility="{Binding SummaryUpdatedText, Converter={StaticResource NullToCollapsed}}" />
                                    </StackPanel>
                                    <ui:ProgressRing
                                        Grid.Column="2"
                                        Width="18"
                                        Height="18"
                                        IsIndeterminate="True"
                                        Visibility="{Binding IsSummaryLoading, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                                <ItemsControl Margin="0,4,0,0" ItemTemplate="{StaticResource InfoEntryTemplate}" ItemsSource="{Binding Summary}" />
                            </StackPanel>
                        </ui:Card>
                    </ItemsControl.Items>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
