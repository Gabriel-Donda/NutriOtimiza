<UserControl x:Class="OtimizaPC.App.Views.SensorsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <DockPanel Margin="28,24,28,0">
        <StackPanel DockPanel.Dock="Top"><TextBlock Style="{StaticResource PageTitle}" Text="Sensores"/><TextBlock Style="{StaticResource PageSubtitle}" Text="{Binding StatusMessage}" TextWrapping="Wrap"/></StackPanel>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,0,28">
            <ui:Card Padding="24" HorizontalContentAlignment="Stretch" Visibility="{Binding HasGroups, Converter={StaticResource InverseBoolToVisibility}}"><StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="Nenhum sensor disponível"/><TextBlock Margin="0,6,0,0" Style="{StaticResource SecondaryText}" Text="Não foi possível obter leituras de hardware nesta sessão." TextWrapping="Wrap"/></StackPanel></ui:Card>
            <ItemsControl ItemsSource="{Binding Groups}"><ItemsControl.ItemTemplate><DataTemplate>
                <ui:Card Style="{StaticResource SectionCard}" Margin="0,0,0,12" Padding="20,14" HorizontalContentAlignment="Stretch"><StackPanel>
                    <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="42" Height="42" CornerRadius="21" Background="{DynamicResource BrandGraphiteBrush}"><ui:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="23" Foreground="{DynamicResource BrandOrangeBrush}" Symbol="{Binding Icon}"/></Border><StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><TextBlock Style="{StaticResource SecondaryText}" Text="{Binding MainKind}" TextTrimming="CharacterEllipsis"/></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal"><Border Margin="0,0,6,0" Padding="9,4" Background="{DynamicResource BrandGraphiteBrush}" CornerRadius="10" Visibility="{Binding HasTemperature, Converter={StaticResource BoolToVisibility}}"><TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrandGoldBrush}" Text="Máx {Binding TemperatureMax}"/></Border><Border Padding="9,4" Background="{DynamicResource BrandGraphiteBrush}" CornerRadius="10"><TextBlock FontSize="11" Foreground="{DynamicResource BrandGoldBrush}" Text="{Binding MainValue}" TextTrimming="CharacterEllipsis"/></Border></StackPanel></Grid>
                    <ItemsControl ItemsSource="{Binding Sections}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,12"><TextBlock Margin="0,0,0,7" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Name}"/><ItemsControl ItemsSource="{Binding Items}" Visibility="{Binding IsGauge, Converter={StaticResource BoolToVisibility}}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource TableRow}"><Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*" MinWidth="120"/><ColumnDefinition Width="2*" MinWidth="50"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock MaxWidth="220" VerticalAlignment="Center" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><ProgressBar Grid.Column="1" Height="5" Margin="8,0,14,0" VerticalAlignment="Center" Maximum="100" Value="{Binding GaugeValue}" Foreground="{Binding StatusBrush}"/><TextBlock Grid.Column="2" Margin="0,0,10,0" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="{Binding Value}"/><StackPanel Grid.Column="3" Orientation="Horizontal"><TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="min "/><TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Min}"/><TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text=" / max "/><TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Max}"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><ItemsControl ItemsSource="{Binding Items}" Visibility="{Binding IsGauge, Converter={StaticResource InverseBoolToVisibility}}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border MinWidth="145" Margin="0,0,8,8" Padding="10,8" Background="{DynamicResource BrandGraphiteBrush}" CornerRadius="7"><StackPanel><TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><TextBlock Margin="0,3,0,0" FontSize="16" FontWeight="SemiBold" Text="{Binding Value}"/><TextBlock FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Min}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </StackPanel></ui:Card>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel></ScrollViewer>
    </DockPanel>
</UserControl>
