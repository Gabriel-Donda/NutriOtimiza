<UserControl x:Class="OtimizaPC.App.Views.SensorsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <Style x:Key="SensorGroupHeaderButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="HeaderChrome" Padding="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderChrome" Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="HeaderChrome" Property="BorderBrush" Value="{DynamicResource FocusStrokeBrush}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="HeaderChrome" Property="Opacity" Value="0.82" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SensorGaugeProgressBar" TargetType="ProgressBar">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" SnapsToDevicePixels="True">
                            <Grid x:Name="PART_Track" ClipToBounds="True"><Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="3" /></Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <DockPanel Margin="28,24,28,0">
        <StackPanel DockPanel.Dock="Top">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                    <ui:Button Appearance="Secondary" Command="{Binding CollapseAllCommand}" Content="Recolher tudo" />
                    <ui:Button Margin="8,0,0,0" Appearance="Secondary" Command="{Binding ExpandAllCommand}" Content="Expandir tudo" />
                </StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="Sensores" TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <TextBlock Style="{StaticResource PageSubtitle}" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
        </StackPanel>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,28">
                <ui:Card Padding="24" HorizontalContentAlignment="Stretch" Visibility="{Binding HasGroups, Converter={StaticResource InverseBoolToVisibility}}">
                    <StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="Nenhum sensor disponível" /><TextBlock Margin="0,6,0,0" Style="{StaticResource SecondaryText}" Text="Não foi possível obter leituras de hardware nesta sessão." TextWrapping="Wrap" /></StackPanel>
                </ui:Card>
                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:Card Style="{StaticResource SectionCard}" Margin="0,0,0,12" Padding="16,12" HorizontalContentAlignment="Stretch">
                                <StackPanel>
                                    <Button Style="{StaticResource SensorGroupHeaderButton}" AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="Expande ou recolhe os sensores deste componente." Command="{Binding DataContext.ToggleGroupCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="{Binding}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <Border Width="42" Height="42" CornerRadius="21" Background="{DynamicResource ControlFillColorDefaultBrush}"><ui:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="23" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Symbol="{Binding Icon}" /></Border>
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" /><TextBlock Style="{StaticResource SecondaryText}" Text="{Binding MainKind}" TextTrimming="CharacterEllipsis" /></StackPanel>
                                            <StackPanel Grid.Column="2" Margin="12,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Margin="0,0,6,0" Padding="9,4" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Visibility="{Binding HasTemperature, Converter={StaticResource BoolToVisibility}}"><TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="Máx {Binding TemperatureMax}" /></Border>
                                                <Border Padding="9,4" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10"><TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding MainValue}" TextTrimming="CharacterEllipsis" /></Border>
                                            </StackPanel>
                                            <ui:SymbolIcon Grid.Column="3" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="20" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Symbol="ChevronDown24">
                                                <ui:SymbolIcon.Style>
                                                    <Style TargetType="ui:SymbolIcon">
                                                        <Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="180" /></Setter.Value></Setter>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                                                <DataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle" To="0" Duration="0:0:0.15" /></Storyboard></BeginStoryboard></DataTrigger.EnterActions>
                                                                <DataTrigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle" To="180" Duration="0:0:0.15" /></Storyboard></BeginStoryboard></DataTrigger.ExitActions>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:SymbolIcon.Style>
                                            </ui:SymbolIcon>
                                        </Grid>
                                    </Button>
                                    <StackPanel Margin="4,16,4,0" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                                        <ItemsControl ItemsSource="{Binding Sections}">
                                            <ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,12">
                                                <TextBlock Margin="0,0,0,7" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Name}" />
                                                <ItemsControl ItemsSource="{Binding Items}" Visibility="{Binding IsGauge, Converter={StaticResource BoolToVisibility}}">
                                                    <ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource TableRow}"><Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*" MinWidth="120" /><ColumnDefinition Width="2*" MinWidth="50" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock MaxWidth="220" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" /><ProgressBar Grid.Column="1" Style="{StaticResource SensorGaugeProgressBar}" Height="6" Margin="8,0,14,0" VerticalAlignment="Center" Maximum="100" Value="{Binding GaugeValue}" Foreground="{Binding StatusBrush}" /><TextBlock Grid.Column="2" Margin="0,0,10,0" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Value}" /><StackPanel Grid.Column="3" Orientation="Horizontal"><TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="min " /><TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Min}" /><TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text=" / max " /><TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Max}" /></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <ItemsControl ItemsSource="{Binding Items}" Visibility="{Binding IsGauge, Converter={StaticResource InverseBoolToVisibility}}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border MinWidth="145" Margin="0,0,8,8" Padding="10,8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="7"><StackPanel><TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" /><TextBlock Margin="0,3,0,0" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Value}" /><TextBlock FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Min}" /></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                            </StackPanel></DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </ui:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
