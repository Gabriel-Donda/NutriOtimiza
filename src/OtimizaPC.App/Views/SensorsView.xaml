<UserControl
    x:Class="OtimizaPC.App.Views.SensorsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <DockPanel Margin="28,24,28,0">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Style="{StaticResource PageTitle}" Text="Sensores" />
            <TextBlock Style="{StaticResource PageSubtitle}" Text="{Binding StatusMessage}" />
        </StackPanel>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <ItemsControl Margin="0,0,0,28" ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:Card
                            Style="{StaticResource SectionCard}"
                            Margin="0,0,0,12"
                            Padding="20,14"
                            HorizontalContentAlignment="Stretch">
                            <StackPanel>
                                <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                                    <ui:SymbolIcon
                                        FontSize="20"
                                        Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                        Symbol="{Binding Icon}" />
                                    <TextBlock
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Text="{Binding Name}" />
                                </StackPanel>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource ColumnHeader}" Text="Sensor" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource ColumnHeader}" Text="Tipo" />
                                    <TextBlock Grid.Column="2" Style="{StaticResource ColumnHeader}" Text="Atual" />
                                    <TextBlock Grid.Column="3" Style="{StaticResource ColumnHeader}" Text="Mínimo" />
                                    <TextBlock Grid.Column="4" Style="{StaticResource ColumnHeader}" Text="Máximo" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource TableRow}">
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="110" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Style="{StaticResource SecondaryText}" Text="{Binding KindName}" />
                                                <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="{Binding Value}" />
                                                <TextBlock Grid.Column="3" Style="{StaticResource SecondaryText}" Text="{Binding Min}" />
                                                <TextBlock Grid.Column="4" Style="{StaticResource SecondaryText}" Text="{Binding Max}" />
                                            </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
