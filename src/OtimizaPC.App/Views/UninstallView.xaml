<UserControl x:Class="OtimizaPC.App.Views.UninstallView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <DockPanel Margin="28,24,28,0">
        <StackPanel DockPanel.Dock="Top">
            <DockPanel>
                <ui:Button Appearance="Secondary" Command="{Binding RefreshCommand}" Content="Atualizar" DockPanel.Dock="Right" Icon="{ui:SymbolIcon ArrowSync24}" />
                <TextBlock Style="{StaticResource PageTitle}" Text="Desinstalador" TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <TextBlock Style="{StaticResource PageSubtitle}" Text="{Binding Summary}" />
            <ui:TextBox Margin="0,0,0,12" AutomationProperties.Name="Buscar por nome ou editora"
                        PlaceholderText="Buscar por nome ou editora"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            <StackPanel Margin="0,0,0,12" Orientation="Horizontal"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                <ui:ProgressRing Width="16" Height="16" Margin="0,0,8,0" IsIndeterminate="True" />
                <TextBlock Style="{StaticResource SecondaryText}" Text="Carregando programas instalados…" />
            </StackPanel>
            <TextBlock Margin="0,0,0,12" Foreground="{DynamicResource StatusCriticalForegroundBrush}"
                       Text="{Binding StatusMessage}" TextWrapping="Wrap"
                       Visibility="{Binding StatusMessage, Converter={StaticResource NullToCollapsed}}" />
        </StackPanel>

        <ScrollViewer Margin="0,0,0,24" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <ItemsControl Margin="0,0,12,0" ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:Card Style="{StaticResource SectionCard}" Margin="0,0,0,12" Padding="16" HorizontalContentAlignment="Stretch">
                            <DockPanel>
                                <Image DockPanel.Dock="Left" Width="32" Height="32" Margin="0,0,12,0"
                                       Source="{Binding Icon}" Stretch="Uniform"
                                       Visibility="{Binding Icon, Converter={StaticResource NullToCollapsed}}" />
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               Text="{Binding Program.DisplayName}" TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding Program.Publisher}" TextWrapping="Wrap" />
                                    <WrapPanel Margin="0,6,0,0">
                                        <TextBlock Margin="0,0,16,0" Style="{StaticResource SecondaryText}"
                                                   Text="{Binding Program.DisplayVersion, StringFormat='Versão {0}'}"
                                                   Visibility="{Binding Program.DisplayVersion, Converter={StaticResource NullToCollapsed}}" />
                                        <TextBlock Margin="0,0,16,0" Style="{StaticResource SecondaryText}"
                                                   Text="{Binding InstallDateText, StringFormat='Data de instalação {0}'}" />
                                        <TextBlock Style="{StaticResource SecondaryText}"
                                                   Text="{Binding EstimatedSizeText, StringFormat='Tamanho {0}'}" />
                                    </WrapPanel>
                                </StackPanel>
                            </DockPanel>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
