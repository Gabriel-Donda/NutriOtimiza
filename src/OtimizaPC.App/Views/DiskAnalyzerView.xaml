<UserControl
    x:Class="OtimizaPC.App.Views.DiskAnalyzerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <DockPanel Margin="28,24,28,24">
        <!-- Cabeçalho -->
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Style="{StaticResource PageTitle}" Text="Espaço em disco" />
            <TextBlock Style="{StaticResource PageSubtitle}" Text="Descubra o que está ocupando espaço" />

            <DockPanel Margin="0,0,0,8">
                <ui:Button
                    Margin="8,0,0,0"
                    Appearance="Secondary"
                    Command="{Binding CancelCommand}"
                    Content="Cancelar"
                    DockPanel.Dock="Right"
                    Icon="{ui:SymbolIcon Dismiss24}"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <ui:Button
                    Margin="8,0,0,0"
                    Appearance="Primary"
                    Command="{Binding AnalyzeCommand}"
                    Content="Analisar"
                    DockPanel.Dock="Right"
                    Icon="{ui:SymbolIcon DataPie24}" />
                <ComboBox
                    DisplayMemberPath="DisplayName"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                    ItemsSource="{Binding Drives}"
                    SelectedItem="{Binding SelectedDrive}" />
            </DockPanel>

            <StackPanel Margin="0,4,0,12" Orientation="Horizontal">
                <ui:ProgressRing
                    Width="16"
                    Height="16"
                    Margin="0,0,8,0"
                    IsIndeterminate="True"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock
                    MaxWidth="900"
                    Style="{StaticResource SecondaryText}"
                    Text="{Binding StatusMessage}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
            </StackPanel>
        </StackPanel>

        <Grid Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="0" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="2*" MinWidth="0" />
            </Grid.ColumnDefinitions>

            <!-- Pastas -->
            <Expander Header="Pastas" IsExpanded="True" KeyboardNavigation.TabIndex="0">
            <ui:Card Padding="16" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                <DockPanel>
                    <DockPanel Margin="0,0,0,10" DockPanel.Dock="Top">
                        <ui:Button
                            AutomationProperties.Name="Subir para a pasta acima"
                            Margin="0,0,10,0"
                            Appearance="Secondary"
                            Command="{Binding GoUpCommand}"
                            DockPanel.Dock="Left"
                            Icon="{ui:SymbolIcon ArrowUp24}"
                            ToolTip="Pasta acima" />
                        <ui:Button
                            AutomationProperties.Name="Abrir local no Explorador"
                            Margin="10,0,0,0"
                            Appearance="Secondary"
                            Command="{Binding OpenInExplorerCommand}"
                            CommandParameter="{Binding SelectedItem, ElementName=EntriesList}"
                            DockPanel.Dock="Right"
                            Icon="{ui:SymbolIcon FolderOpen24}"
                            ToolTip="Abrir no Explorador" />
                        <TextBlock
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            DockPanel.Dock="Right"
                            FontWeight="SemiBold"
                            Text="{Binding CurrentSizeText}" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource SecondaryText}" Text="Local atual › " />
                            <TextBlock
                                FontWeight="SemiBold"
                                Text="{Binding CurrentPath}"
                                TextTrimming="CharacterEllipsis"
                                ToolTip="{Binding CurrentPath}" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock
                        Margin="0,8,0,0"
                        DockPanel.Dock="Bottom"
                        FontSize="12"
                        Style="{StaticResource SecondaryText}"
                        Text="Clique duas vezes numa pasta para ver o conteúdo." />
                    <ListBox
                        x:Name="EntriesList"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemsSource="{Binding Entries}"
                        KeyDown="OnEntriesKeyDown"
                        MouseDoubleClick="OnEntriesDoubleClick"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon
                                        Margin="0,0,10,0"
                                        FontSize="18"
                                        Symbol="{Binding Icon}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontSize="11"
                                            Style="{StaticResource SecondaryText}"
                                            Text="{Binding Detail}" />
                                    </StackPanel>
                                    <StackPanel
                                        Grid.Column="2"
                                        Margin="8,0"
                                        VerticalAlignment="Center">
                                        <ProgressBar
                                            Height="6"
                                            Maximum="100"
                                            Value="{Binding Percent, Mode=OneWay}" />
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            FontSize="11"
                                            Style="{StaticResource SecondaryText}"
                                            Text="{Binding PercentText}" />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="3"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Text="{Binding SizeText}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </ui:Card>
            </Expander>

            <!-- Maiores arquivos -->
            <Expander
                Grid.Column="2"
                Header="Maiores arquivos"
                IsExpanded="True"
                KeyboardNavigation.TabIndex="1">
                <ui:Card Padding="16" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                <DockPanel>
                    <TextBlock
                        Margin="0,4,0,12"
                        DockPanel.Dock="Top"
                        Style="{StaticResource SectionTitle}"
                        Text="Maiores arquivos" />
                    <ListBox
                        Background="Transparent"
                        BorderThickness="0"
                        ItemsSource="{Binding LargestFiles}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2" ToolTip="{Binding Path}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontSize="11"
                                            Style="{StaticResource SecondaryText}"
                                            Text="{Binding Folder}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap" />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="8,0"
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Text="{Binding SizeText}" />
                                    <ui:Button
                                        Grid.Column="2"
                                        Padding="6"
                                        Appearance="Transparent"
                                        AutomationProperties.Name="Mostrar arquivo no Explorador"
                                        Command="{Binding DataContext.OpenInExplorerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Icon="{ui:SymbolIcon FolderOpen24}"
                                        ToolTip="Mostrar no Explorador" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
                </ui:Card>
            </Expander>
        </Grid>
    </DockPanel>
</UserControl>
