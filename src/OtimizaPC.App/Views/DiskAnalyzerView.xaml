<UserControl
    x:Class="OtimizaPC.App.Views.DiskAnalyzerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:motion="clr-namespace:OtimizaPC.App.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <UserControl.Resources>
        <!-- Cabeçalho clicável de cartão recolhível (mesmo padrão de Sensores e Hardware). Estado só em memória. -->
        <Style x:Key="DiskSectionHeaderButton" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="HeaderChrome" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderChrome" Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="HeaderChrome" Property="BorderBrush" Value="{DynamicResource FocusStrokeBrush}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="HeaderChrome" Property="Opacity" Value="0.82" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="28,24,28,24">
        <!-- Cabeçalho -->
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Style="{StaticResource PageTitle}" Text="Espaço em disco" />
            <TextBlock Style="{StaticResource PageSubtitle}" Text="Descubra o que está ocupando espaço" />

            <DockPanel Margin="0,0,0,8">
                <ui:Button
                    Margin="8,0,0,0"
                    Appearance="Secondary"
                    Command="{Binding CancelCommand}"
                    Content="Cancelar"
                    DockPanel.Dock="Right"
                    Icon="{ui:SymbolIcon Dismiss24}"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <ui:Button
                    Margin="8,0,0,0"
                    Appearance="Primary"
                    Command="{Binding AnalyzeCommand}"
                    Content="Analisar"
                    DockPanel.Dock="Right"
                    Icon="{ui:SymbolIcon DataPie24}" />
                <Grid>
                    <ComboBox
                        MinWidth="220"
                        VerticalContentAlignment="Center"
                        DisplayMemberPath="DisplayName"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                        ItemsSource="{Binding Drives}"
                        SelectedItem="{Binding SelectedDrive}" />
                    <!-- Orientação quando nenhuma unidade está selecionada -->
                    <TextBlock
                        Margin="12,0,36,0"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False"
                        Style="{StaticResource SecondaryText}"
                        Text="Escolha uma unidade para analisar"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{Binding SelectedDrive, Converter={StaticResource NullToVisible}}" />
                </Grid>
            </DockPanel>

            <StackPanel Margin="0,8,0,16" Orientation="Horizontal">
                <ui:ProgressRing
                    Width="16"
                    Height="16"
                    Margin="0,0,8,0"
                    IsIndeterminate="True"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock
                    MaxWidth="900"
                    Style="{StaticResource SecondaryText}"
                    Text="{Binding StatusMessage}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
            </StackPanel>
        </StackPanel>

        <Grid>
            <!-- Estado vazio: antes da primeira análise -->
            <ui:Card
                Padding="32"
                HorizontalContentAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{Binding HasResult, Converter={StaticResource InverseBoolToVisibility}}">
                <StackPanel HorizontalAlignment="Center" MaxWidth="420">
                    <Border
                        Width="56"
                        Height="56"
                        HorizontalAlignment="Center"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        CornerRadius="28">
                        <ui:SymbolIcon
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="26"
                            Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                            Symbol="DataPie24" />
                    </Border>
                    <TextBlock
                        Margin="0,16,0,0"
                        HorizontalAlignment="Center"
                        FontSize="17"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="Analise o espaço de um disco"
                        TextAlignment="Center" />
                    <TextBlock
                        Margin="0,6,0,0"
                        HorizontalAlignment="Center"
                        Style="{StaticResource SecondaryText}"
                        Text="Escolha uma unidade e clique em Analisar para ver as pastas que mais ocupam espaço e os maiores arquivos."
                        TextAlignment="Center" />
                </StackPanel>
            </ui:Card>

            <!-- Resultado: pastas à esquerda, maiores arquivos à direita. Cada cartão tem a altura do próprio conteúdo, colado no topo. -->
            <Grid Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" MinWidth="0" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="2*" MinWidth="0" />
                </Grid.ColumnDefinitions>

                <!-- Pastas -->
                <ui:Card Padding="16" HorizontalContentAlignment="Stretch" VerticalAlignment="Top" VerticalContentAlignment="Top">
                    <DockPanel>
                        <ToggleButton
                            x:Name="FoldersToggle"
                            Margin="0,0,0,12"
                            AutomationProperties.HelpText="Expande ou recolhe a lista de pastas."
                            AutomationProperties.Name="Pastas"
                            DockPanel.Dock="Top"
                            IsChecked="True"
                            Style="{StaticResource DiskSectionHeaderButton}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="16">
                                    <ui:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Symbol="Folder24" />
                                </Border>
                                <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="Pastas" />
                                <!-- Chevron: para cima quando expandido, para baixo quando recolhido. Estado = IsChecked deste cabeçalho. -->
                                <ui:SymbolIcon
                                    Grid.Column="2"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="20"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    RenderTransformOrigin="0.5,0.5"
                                    Symbol="ChevronDown24">
                                    <ui:SymbolIcon.RenderTransform>
                                        <RotateTransform Angle="180" />
                                    </ui:SymbolIcon.RenderTransform>
                                    <ui:SymbolIcon.Style>
                                        <Style TargetType="ui:SymbolIcon">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChecked, ElementName=FoldersToggle}" Value="False">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle" To="0" Duration="0:0:0.15" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle" To="180" Duration="0:0:0.15" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>
                            </Grid>
                        </ToggleButton>

                        <!-- Recolher/expandir com altura e opacidade animadas (ver MotionBehaviors.Expanded) -->
                        <Border ClipToBounds="True" motion:MotionBehaviors.Expanded="{Binding IsChecked, ElementName=FoldersToggle}">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                    <ui:Button
                                        AutomationProperties.Name="Subir para a pasta acima"
                                        Margin="0,0,8,0"
                                        Appearance="Secondary"
                                        Command="{Binding GoUpCommand}"
                                        DockPanel.Dock="Left"
                                        Icon="{ui:SymbolIcon ArrowUp24}"
                                        ToolTip="Pasta acima" />
                                    <ui:Button
                                        AutomationProperties.Name="Abrir local no Explorador"
                                        Margin="8,0,0,0"
                                        Appearance="Secondary"
                                        Command="{Binding OpenInExplorerCommand}"
                                        CommandParameter="{Binding SelectedItem, ElementName=EntriesList}"
                                        DockPanel.Dock="Right"
                                        Icon="{ui:SymbolIcon FolderOpen24}"
                                        ToolTip="Abrir no Explorador" />
                                    <TextBlock
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        DockPanel.Dock="Right"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                        Text="{Binding CurrentSizeText}" />
                                    <!-- Caminho ocupa o espaço restante e é cortado com reticências; o caminho completo fica no tooltip -->
                                    <DockPanel VerticalAlignment="Center" ToolTip="{Binding CurrentPath}">
                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource SecondaryText}" Text="Local atual › " TextWrapping="NoWrap" />
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Text="{Binding CurrentPath}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap" />
                                    </DockPanel>
                                </DockPanel>

                                <TextBlock
                                    Margin="0,8,0,0"
                                    DockPanel.Dock="Bottom"
                                    FontSize="12"
                                    Style="{StaticResource SecondaryText}"
                                    Text="Clique duas vezes numa pasta para ver o conteúdo." />

                                <ListBox
                                    x:Name="EntriesList"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ItemsSource="{Binding Entries}"
                                    KeyDown="OnEntriesKeyDown"
                                    MouseDoubleClick="OnEntriesDoubleClick"
                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <!-- Duas linhas: nome e tamanho em cima; barra de proporção embaixo. Cabe em janela estreita. -->
                                            <Grid Margin="0,6">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ui:SymbolIcon
                                                    Grid.RowSpan="2"
                                                    Margin="0,0,12,0"
                                                    VerticalAlignment="Top"
                                                    FontSize="20"
                                                    Symbol="{Binding Icon}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Grid.Column="2"
                                                    Margin="12,0,0,0"
                                                    FontWeight="SemiBold"
                                                    Text="{Binding SizeText}" />
                                                <TextBlock
                                                    Grid.Row="1"
                                                    Grid.Column="1"
                                                    FontSize="12"
                                                    Style="{StaticResource SecondaryText}"
                                                    Text="{Binding Detail}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Grid.Row="1"
                                                    Grid.Column="2"
                                                    Margin="12,0,0,0"
                                                    FontSize="12"
                                                    Style="{StaticResource SecondaryText}"
                                                    Text="{Binding PercentText}" />
                                                <ProgressBar
                                                    Grid.Row="2"
                                                    Grid.ColumnSpan="3"
                                                    Height="6"
                                                    Margin="0,6,0,0"
                                                    Maximum="100"
                                                    Value="{Binding Percent, Mode=OneWay}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                    </DockPanel>
                </ui:Card>

                <!-- Maiores arquivos -->
                <ui:Card Grid.Column="2" Padding="16" HorizontalContentAlignment="Stretch" VerticalAlignment="Top" VerticalContentAlignment="Top">
                    <DockPanel>
                        <ToggleButton
                            x:Name="LargeFilesToggle"
                            Margin="0,0,0,12"
                            AutomationProperties.HelpText="Expande ou recolhe a lista de maiores arquivos."
                            AutomationProperties.Name="Maiores arquivos"
                            DockPanel.Dock="Top"
                            IsChecked="True"
                            Style="{StaticResource DiskSectionHeaderButton}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="16">
                                    <ui:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Symbol="Document24" />
                                </Border>
                                <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="Maiores arquivos" />
                                <!-- Chevron: para cima quando expandido, para baixo quando recolhido. Estado = IsChecked deste cabeçalho. -->
                                <ui:SymbolIcon
                                    Grid.Column="2"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="20"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    RenderTransformOrigin="0.5,0.5"
                                    Symbol="ChevronDown24">
                                    <ui:SymbolIcon.RenderTransform>
                                        <RotateTransform Angle="180" />
                                    </ui:SymbolIcon.RenderTransform>
                                    <ui:SymbolIcon.Style>
                                        <Style TargetType="ui:SymbolIcon">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChecked, ElementName=LargeFilesToggle}" Value="False">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle" To="0" Duration="0:0:0.15" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle" To="180" Duration="0:0:0.15" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>
                            </Grid>
                        </ToggleButton>

                        <Border ClipToBounds="True" motion:MotionBehaviors.Expanded="{Binding IsChecked, ElementName=LargeFilesToggle}">
                            <ListBox
                                Background="Transparent"
                                BorderThickness="0"
                                ItemsSource="{Binding LargestFiles}"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <!-- O caminho completo quebra em linhas (sem reticências); o tooltip mostra o caminho inteiro -->
                                        <Grid Margin="0,6" ToolTip="{Binding Path}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    FontSize="11"
                                                    Style="{StaticResource SecondaryText}"
                                                    Text="{Binding Folder}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                            <TextBlock
                                                Grid.Column="1"
                                                Margin="12,0"
                                                VerticalAlignment="Center"
                                                FontWeight="SemiBold"
                                                Text="{Binding SizeText}" />
                                            <ui:Button
                                                Grid.Column="2"
                                                Padding="6"
                                                VerticalAlignment="Center"
                                                Appearance="Transparent"
                                                AutomationProperties.Name="Mostrar arquivo no Explorador"
                                                Command="{Binding DataContext.OpenInExplorerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Icon="{ui:SymbolIcon FolderOpen24}"
                                                ToolTip="Mostrar no Explorador" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </DockPanel>
                </ui:Card>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
