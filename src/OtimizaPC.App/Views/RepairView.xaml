<UserControl
    x:Class="OtimizaPC.App.Views.RepairView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:OtimizaPC.App.ViewModels">

    <DockPanel Margin="28,24,28,24">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Style="{StaticResource PageTitle}" Text="Reparo" />
            <TextBlock Style="{StaticResource PageSubtitle}" Text="Ferramentas de diagnóstico e reparo do Windows em um só lugar." />
        </StackPanel>

        <TabControl SelectedIndex="{Binding SelectedTab}">
            <!-- ================= Ferramentas ================= -->
            <TabItem Header="Ferramentas">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition MinWidth="320" Width="2*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>

                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding ToolGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ui:Card
                                            Style="{StaticResource RepairCard}"
                                            Margin="0,0,0,12"
                                            Padding="16,12"
                                            HorizontalContentAlignment="Stretch">
                                            <StackPanel>
                                                <TextBlock
                                                    Margin="0,0,0,4"
                                                    Style="{StaticResource SectionTitle}"
                                                    Text="{Binding Name}" />
                                                <ItemsControl ItemsSource="{Binding Items}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <DockPanel Margin="0,8">
                                                                <ui:Button
                                                                    Margin="12,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    Appearance="Secondary"
                                                                    Command="{Binding RunCommand}"
                                                                    Content="Executar"
                                                                    DockPanel.Dock="Right" />
                                                                <StackPanel>
                                                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextWrapping="Wrap" />
                                                                    <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding Description}" />
                                                                    <TextBlock
                                                                        FontSize="11"
                                                                        Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                                        Text="{Binding Detail}" />
                                                                </StackPanel>
                                                            </DockPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </ui:Card>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ui:Card Style="{StaticResource RepairCard}" Padding="16,12" HorizontalContentAlignment="Stretch">
                                <StackPanel>
                                    <TextBlock
                                        Margin="0,0,0,8"
                                        Style="{StaticResource SectionTitle}"
                                        Text="Atalhos do Windows" />
                                    <ItemsControl ItemsSource="{Binding Shortcuts}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="2" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <ui:Button
                                                    Margin="0,0,6,6"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    Appearance="Transparent"
                                                    Command="{Binding DataContext.OpenShortcutCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="{Binding Description}">
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                </ui:Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ui:Card>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Console -->
                    <ui:Card
                        Style="{StaticResource RepairCard}"
                        Grid.Column="2"
                        Padding="16,12"
                        VerticalAlignment="Stretch"
                        VerticalContentAlignment="Stretch">
                        <DockPanel>
                            <DockPanel Margin="0,0,0,8" DockPanel.Dock="Top">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <ui:Button
                                        Margin="0,0,8,0"
                                        Appearance="Secondary"
                                        Command="{Binding CancelCommand}"
                                        Content="Interromper"
                                        Icon="{ui:SymbolIcon Stop24}"
                                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                                    <ui:Button
                                        Appearance="Transparent"
                                            AutomationProperties.Name="Copiar saída do console"
                                        Command="{Binding CopyConsoleCommand}"
                                        Icon="{ui:SymbolIcon Copy24}"
                                        ToolTip="Copiar saída" />
                                </StackPanel>
                                <ui:ProgressRing
                                    Width="18"
                                    Height="18"
                                    Margin="0,0,10,0"
                                    DockPanel.Dock="Left"
                                    IsIndeterminate="True"
                                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SectionTitle}"
                                    Text="{Binding ConsoleTitle}"
                                    TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <DockPanel Margin="0,8,0,0" DockPanel.Dock="Top">
                                <TextBlock
                                    Margin="8,0,0,0"
                                    DockPanel.Dock="Right"
                                    FontWeight="SemiBold"
                                    Text="{Binding ProgressText}" />
                                <ProgressBar Height="14" Maximum="100" Value="{Binding Progress}" />
                            </DockPanel>

                            <Border
                                Margin="0,8,0,0"
                                Padding="12,8"
                                BorderBrush="{Binding ResultStatus, Converter={StaticResource StatusToBrush}}"
                                BorderThickness="1"
                                CornerRadius="6"
                                DockPanel.Dock="Bottom"
                                Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon
                                        Margin="0,0,10,0"
                                        Foreground="{Binding ResultStatus, Converter={StaticResource StatusToBrush}}"
                                        Symbol="{Binding ResultStatus, Converter={StaticResource StatusToSymbol}}" />
                                    <TextBlock
                                        MaxWidth="560"
                                        Text="{Binding ResultText}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border
                                Background="{DynamicResource LogBackgroundBrush}"
                                CornerRadius="6">
                                <ListBox
                                    x:Name="ConsoleList"
                                    Padding="8"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontFamily="Consolas"
                                    FontSize="12"
                                    ItemsSource="{Binding ConsoleLines}"
                                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                    VirtualizingPanel.IsVirtualizing="True">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0" />
                                            <Setter Property="Focusable" Value="False" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter />
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Text}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource LogForegroundBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource LogErrorForegroundBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </DockPanel>
                    </ui:Card>
                </Grid>
            </TabItem>

            <!-- ================= Erros do sistema ================= -->
            <TabItem Header="Erros do sistema">
                <DockPanel Margin="0,12,0,0">

                    <!-- Barra de ferramentas: resumo + filtros + busca + Corrigir recomendados + Atualizar -->
                    <DockPanel Margin="0,0,0,10" DockPanel.Dock="Top">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <ui:Button
                                Margin="0,0,8,0"
                                Appearance="Secondary"
                                Command="{Binding FixRecommendedCommand}"
                                Content="Corrigir recomendados"
                                Icon="{ui:SymbolIcon Wrench24}"
                                ToolTip="Executa em fila todos os reparos de risco baixo/nenhum que não requerem reiniciar, com uma única confirmação." />
                            <ui:Button
                                Appearance="Secondary"
                                Command="{Binding LoadEventsCommand}"
                                Content="Atualizar"
                                Icon="{ui:SymbolIcon ArrowSync24}" />
                        </StackPanel>
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource SecondaryText}"
                            Text="{Binding EventsStatus}"
                            TextWrapping="NoWrap"
                            TextTrimming="CharacterEllipsis" />
                    </DockPanel>

                    <!-- Filtros + busca + ordenação -->
                    <DockPanel Margin="0,0,0,10" DockPanel.Dock="Top">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,4,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource SecondaryText}"
                                Text="Ordenar:" />
                            <ComboBox
                                MinWidth="130"
                                SelectedIndex="{Binding EventSort, Mode=TwoWay, Converter={StaticResource InverseBool}, ConverterParameter=x}">
                                <ComboBox.ItemsSource>
                                    <x:Array Type="sys:String" xmlns:sys="clr-namespace:System;assembly=mscorlib">
                                        <sys:String>Por gravidade</sys:String>
                                        <sys:String>Por quantidade</sys:String>
                                    </x:Array>
                                </ComboBox.ItemsSource>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <!-- Filtros de categoria como toggle buttons (usando RadioButton com estilo de botão) -->
                            <RadioButton
                                Margin="0,0,4,0"
                                GroupName="EventFilter"
                                IsChecked="{Binding FilterTodos, Mode=TwoWay}"
                                Style="{StaticResource {x:Type ToggleButton}}"
                                Content="Todos" />
                            <RadioButton
                                Margin="0,0,4,0"
                                GroupName="EventFilter"
                                IsChecked="{Binding FilterCorrigiveis, Mode=TwoWay}"
                                Style="{StaticResource {x:Type ToggleButton}}"
                                Content="Corrigíveis" />
                            <RadioButton
                                Margin="0,0,4,0"
                                GroupName="EventFilter"
                                IsChecked="{Binding FilterHardware, Mode=TwoWay}"
                                Style="{StaticResource {x:Type ToggleButton}}"
                                Content="Hardware" />
                            <RadioButton
                                Margin="0,0,8,0"
                                GroupName="EventFilter"
                                IsChecked="{Binding FilterInformativos, Mode=TwoWay}"
                                Style="{StaticResource {x:Type ToggleButton}}"
                                Content="Informativos" />
                            <RadioButton
                                Margin="0,0,8,0"
                                GroupName="EventFilter"
                                IsChecked="{Binding FilterResolvidos, Mode=TwoWay}"
                                Style="{StaticResource {x:Type ToggleButton}}"
                                Content="{Binding ResolvedFilterText}" />
                            <ui:TextBox
                                MinWidth="200"
                                PlaceholderText="Buscar…"
                                Text="{Binding EventSearch, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </DockPanel>

                    <!-- Lista de cartões de erros -->
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Events}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:EventItemViewModel}">
                                    <ui:Card
                                        Style="{StaticResource RepairCard}"
                                        Margin="0,0,0,10"
                                        Padding="16,12"
                                        HorizontalContentAlignment="Stretch">
                                        <StackPanel>

                                            <!-- Linha de cabeçalho: ícone de status + selo de classificação + título -->
                                            <DockPanel Margin="0,0,0,4">
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                                    <!-- Selo de classificação colorido -->
                                                    <Border
                                                        Style="{StaticResource Badge}"
                                                        Background="{Binding Diagnosis.Classification, Converter={StaticResource DiagnosisClassToBrush}}"
                                                        CornerRadius="4"
                                                        Padding="7,2"
                                                        Margin="4,0,0,0"
                                                        VerticalAlignment="Center">
                                                        <TextBlock
                                                            FontSize="11"
                                                            FontWeight="SemiBold"
                                                            Foreground="White"
                                                            Text="{Binding Diagnosis.Classification, Converter={StaticResource DiagnosisClassToLabel}}" />
                                                    </Border>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon
                                                        Margin="0,1,10,0"
                                                        VerticalAlignment="Top"
                                                        FontSize="20"
                                                        Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}"
                                                        Symbol="{Binding Status, Converter={StaticResource StatusToSymbol}}" />
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DockPanel>

                                            <!-- Assunto (programa) -->
                                            <TextBlock
                                                Margin="30,0,0,0"
                                                Text="{Binding Subject}"
                                                Visibility="{Binding Subject, Converter={StaticResource NullToCollapsed}}" />

                                            <!-- Metadados (provider · ID · log · contagem · datas) -->
                                            <TextBlock
                                                Margin="30,2,0,0"
                                                FontSize="12"
                                                Style="{StaticResource SecondaryText}"
                                                Text="{Binding Detail}" />

                                            <StackPanel Margin="30,5,0,0" Visibility="{Binding IsResolved, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource StatusOkBrush}" Text="{Binding ResolvedLabel}" />
                                                <TextBlock FontSize="11" Style="{StaticResource SecondaryText}" Text="{Binding HistoryNote}" TextWrapping="Wrap" />
                                            </StackPanel>

                                            <!-- Texto diagnóstico simples -->
                                            <TextBlock
                                                Margin="30,6,0,0"
                                                Text="{Binding Diagnosis.PlainText}"
                                                TextWrapping="Wrap" />

                                            <!-- Evidência -->
                                            <TextBlock
                                                Margin="30,2,0,0"
                                                FontSize="12"
                                                Style="{StaticResource SecondaryText}"
                                                Text="{Binding Diagnosis.Evidence}"
                                                TextWrapping="Wrap"
                                                Visibility="{Binding Diagnosis.Evidence, Converter={StaticResource NullToCollapsed}}" />

                                            <!-- Mensagem do Windows (Expander funcional, texto selecionável) -->
                                            <Expander Margin="30,6,0,0" Header="Mensagem do Windows" Style="{x:Null}">
                                                <TextBox
                                                    MinHeight="36"
                                                    MaxHeight="140"
                                                    Margin="0,4,0,0"
                                                    Padding="0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    FontSize="12"
                                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                    HorizontalScrollBarVisibility="Disabled"
                                                    IsReadOnly="True"
                                                    Text="{Binding Message, Mode=OneWay}"
                                                    TextWrapping="Wrap"
                                                    VerticalScrollBarVisibility="Auto"
                                                    Style="{x:Null}" />
                                            </Expander>

                                            <!-- ===== Botões de correção (quando há fixes) ===== -->
                                            <ItemsControl
                                                Margin="30,8,0,0"
                                                ItemsSource="{Binding Fixes}"
                                                Visibility="{Binding HasFixes, Converter={StaticResource BoolToVisibility}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:EventFixItemViewModel}">
                                                        <StackPanel Margin="0,0,0,8">
                                                            <!-- Botão principal de correção -->
                                                            <DockPanel>
                                                                <ui:Button
                                                                    DockPanel.Dock="Left"
                                                                    Appearance="Secondary"
                                                                    Command="{Binding RunCommand}"
                                                                    Content="{Binding Title}"
                                                                    ToolTip="{Binding ToolTipText}"
                                                                    IsEnabled="{Binding IsEnabled}"
                                                                    Margin="0,0,8,0" />
                                                                <!-- Aviso sem admin -->
                                                                <TextBlock
                                                                    VerticalAlignment="Center"
                                                                    FontSize="11"
                                                                    Foreground="{DynamicResource StatusWarningBrush}"
                                                                    Text="Requer administrador"
                                                                    Visibility="{Binding IsEnabled, Converter={StaticResource InverseBoolToVisibility}}" />
                                                                <!-- Indicadores de risco/restart -->
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Border
                                                                        Style="{StaticResource Badge}"
                                                                        Background="{DynamicResource StatusWarningBrush}"
                                                                        Margin="4,0,0,0"
                                                                        Padding="5,1"
                                                                        Visibility="{Binding RequiresRestart, Converter={StaticResource BoolToVisibility}}">
                                                                        <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="White" Text="reinício" />
                                                                    </Border>
                                                                </StackPanel>
                                                            </DockPanel>

                                                            <!-- Painel de progresso por fix (visível durante execução) -->
                                                            <StackPanel
                                                                Margin="0,6,0,0"
                                                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
                                                                <DockPanel Margin="0,0,0,4">
                                                                    <TextBlock DockPanel.Dock="Right" FontWeight="SemiBold" Text="{Binding ProgressText}" />
                                                                    <ProgressBar Height="6" Maximum="100" Value="{Binding Progress}" />
                                                                </DockPanel>
                                                                <Border
                                                                    Background="{DynamicResource LogBackgroundBrush}"
                                                                    CornerRadius="4"
                                                                    MaxHeight="120">
                                                                    <ListBox
                                                                        Padding="6"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        FontFamily="Consolas"
                                                                        FontSize="11"
                                                                        ItemsSource="{Binding OutputLines}"
                                                                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                                        VirtualizingPanel.IsVirtualizing="True">
                                                                        <ListBox.ItemContainerStyle>
                                                                            <Style TargetType="ListBoxItem">
                                                                                <Setter Property="Padding" Value="0" />
                                                                                <Setter Property="Margin" Value="0" />
                                                                                <Setter Property="Focusable" Value="False" />
                                                                                <Setter Property="Template">
                                                                                    <Setter.Value>
                                                                                        <ControlTemplate TargetType="ListBoxItem">
                                                                                            <ContentPresenter />
                                                                                        </ControlTemplate>
                                                                                    </Setter.Value>
                                                                                </Setter>
                                                                            </Style>
                                                                        </ListBox.ItemContainerStyle>
                                                                        <ListBox.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <TextBlock Text="{Binding Text}">
                                                                                    <TextBlock.Style>
                                                                                        <Style TargetType="TextBlock">
                                                                                            <Setter Property="Foreground" Value="{DynamicResource LogForegroundBrush}" />
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                                                                                    <Setter Property="Foreground" Value="{DynamicResource LogErrorForegroundBrush}" />
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </TextBlock.Style>
                                                                                </TextBlock>
                                                                            </DataTemplate>
                                                                        </ListBox.ItemTemplate>
                                                                    </ListBox>
                                                                </Border>
                                                            </StackPanel>

                                                            <!-- Resultado do fix (sucesso/falha) -->
                                                            <Border
                                                                Margin="0,6,0,0"
                                                                Padding="10,6"
                                                                CornerRadius="5"
                                                                Visibility="{Binding Result, Converter={StaticResource NullToCollapsed}}">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="BorderThickness" Value="1" />
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource StatusOkBrush}" />
                                                                    </Style>
                                                                </Border.Style>
                                                                <DockPanel>
                                                                    <TextBlock
                                                                        DockPanel.Dock="Right"
                                                                        Margin="8,0,0,0"
                                                                        FontSize="11"
                                                                        Style="{StaticResource SecondaryText}"
                                                                        Text="{Binding Result.Timestamp, StringFormat='{}{0:HH:mm:ss}'}" />
                                                                    <TextBlock Text="{Binding Result.Summary}" TextWrapping="Wrap" />
                                                                </DockPanel>
                                                            </Border>
                                                            <ItemsControl Margin="0,5,0,0" ItemsSource="{Binding Result.VerificationSteps}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <ui:SymbolIcon FontSize="14" Margin="0,0,5,0" Symbol="{Binding Symbol}">
                                                                                <ui:SymbolIcon.Style>
                                                                                    <Style TargetType="ui:SymbolIcon">
                                                                                        <Setter Property="Foreground" Value="{DynamicResource StatusCriticalBrush}" />
                                                                                        <Style.Triggers><DataTrigger Binding="{Binding Success}" Value="True"><Setter Property="Foreground" Value="{DynamicResource StatusOkBrush}" /></DataTrigger></Style.Triggers>
                                                                                    </Style>
                                                                                </ui:SymbolIcon.Style>
                                                                            </ui:SymbolIcon>
                                                                            <TextBlock Text="{Binding Label}">
                                                                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource StatusCriticalBrush}" /><Style.Triggers><DataTrigger Binding="{Binding Success}" Value="True"><Setter Property="Foreground" Value="{DynamicResource StatusOkBrush}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                                            </TextBlock>
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Botão Interromper (visível quando algum fix do cartão está rodando) -->
                                            <DockPanel
                                                Margin="30,4,0,0"
                                                Visibility="{Binding IsFixRunning, Converter={StaticResource BoolToVisibility}}">
                                                <ui:Button
                                                    DockPanel.Dock="Left"
                                                    Appearance="Secondary"
                                                    Command="{Binding CancelFixCommand}"
                                                    Content="Interromper"
                                                    Icon="{ui:SymbolIcon Stop24}" />
                                            </DockPanel>

                                            <!-- Botão Verificar de novo (após fix concluído) -->
                                            <DockPanel
                                                Margin="30,4,0,0"
                                                Visibility="{Binding FixResult, Converter={StaticResource NullToCollapsed}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border
                                                        Margin="0,0,8,0"
                                                        Padding="10,5"
                                                        CornerRadius="5"
                                                        BorderThickness="1"
                                                        BorderBrush="{DynamicResource StatusOkBrush}">
                                                        <DockPanel>
                                                            <ui:SymbolIcon
                                                                DockPanel.Dock="Left"
                                                                Margin="0,0,6,0"
                                                                FontSize="16"
                                                                Foreground="{DynamicResource StatusOkBrush}"
                                                                Symbol="CheckmarkCircle24" />
                                                            <TextBlock Text="{Binding FixResult.Summary}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                        </DockPanel>
                                                    </Border>
                                                    <ui:Button
                                                        Appearance="Transparent"
                                                        Command="{Binding ReloadCommand}"
                                                        Content="Verificar de novo"
                                                        Icon="{ui:SymbolIcon ArrowSync24}" />
                                                </StackPanel>
                                            </DockPanel>

                                            <!-- ===== Orientação quando não há correção automática ===== -->
                                            <StackPanel
                                                Margin="30,8,0,0"
                                                Visibility="{Binding HasGuidance, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                    Text="{Binding GuidanceText}"
                                                    TextWrapping="Wrap" />
                                                <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                                    <ui:Button
                                                        Margin="0,0,8,0"
                                                        Appearance="Transparent"
                                                        Command="{Binding OpenEventViewerCommand}"
                                                        Content="Abrir Visualizador de Eventos"
                                                        Icon="{ui:SymbolIcon WindowConsole20}" />
                                                    <ui:Button
                                                        Appearance="Transparent"
                                                        Command="{Binding CopyDetailsCommand}"
                                                        Content="Copiar detalhes"
                                                        Icon="{ui:SymbolIcon Copy24}" />
                                                </StackPanel>
                                            </StackPanel>

                                        </StackPanel>
                                    </ui:Card>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                </DockPanel>
            </TabItem>

            <!-- ================= Telas azuis ================= -->
            <TabItem Header="Telas azuis">
                <DockPanel Margin="0,12,0,0">
                    <DockPanel Margin="0,0,0,12" DockPanel.Dock="Top">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <ui:Button
                                Margin="0,0,8,0"
                                Appearance="Secondary"
                                Command="{Binding OpenMinidumpFolderCommand}"
                                Content="Pasta de despejos"
                                Icon="{ui:SymbolIcon FolderOpen24}" />
                            <ui:Button
                                Appearance="Secondary"
                                Command="{Binding LoadCrashesCommand}"
                                Content="Atualizar"
                                Icon="{ui:SymbolIcon ArrowSync24}" />
                        </StackPanel>
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource SecondaryText}"
                            Text="{Binding CrashesStatus}" />
                    </DockPanel>
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Crashes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ui:Card
                                        Style="{StaticResource RepairCard}"
                                        Margin="0,0,0,8"
                                        Padding="16,10"
                                        HorizontalContentAlignment="Stretch">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ui:SymbolIcon
                                                Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}"
                                                Style="{StaticResource StatusIcon}"
                                                Symbol="{Binding Status, Converter={StaticResource StatusToSymbol}}" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                                <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding Explanation}" />
                                                <TextBox
                                                    FontSize="11"
                                                    Style="{StaticResource SelectableText}"
                                                    Text="{Binding Detail, Mode=OneWay}"
                                                    Visibility="{Binding Detail, Converter={StaticResource NullToCollapsed}}" />
                                            </StackPanel>
                                            <TextBlock
                                                Grid.Column="2"
                                                Margin="12,0,0,0"
                                                Style="{StaticResource SecondaryText}"
                                                Text="{Binding When}" />
                                        </Grid>
                                    </ui:Card>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- ================= Dispositivos e drivers ================= -->
            <TabItem Header="Dispositivos e drivers">
                <DockPanel Margin="0,12,0,0">
                    <DockPanel Margin="0,0,0,12" DockPanel.Dock="Top">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <ui:Button
                                Margin="0,0,8,0"
                                Appearance="Secondary"
                                Command="{Binding OpenDeviceManagerCommand}"
                                Content="Gerenciador de Dispositivos" />
                            <ui:Button
                                Appearance="Secondary"
                                Command="{Binding LoadDevicesCommand}"
                                Content="Atualizar"
                                Icon="{ui:SymbolIcon ArrowSync24}" />
                        </StackPanel>
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource SecondaryText}"
                            Text="{Binding DevicesStatus}" />
                    </DockPanel>

                    <ItemsControl
                        Margin="0,0,0,8"
                        DockPanel.Dock="Top"
                        ItemsSource="{Binding DeviceProblems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:Card
                                    Style="{StaticResource RepairCard}"
                                    Margin="0,0,0,8"
                                    Padding="16,10"
                                    HorizontalContentAlignment="Stretch">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon
                                            Foreground="{DynamicResource StatusWarningBrush}"
                                            Style="{StaticResource StatusIcon}"
                                            Symbol="Warning24" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock FontWeight="SemiBold">
                                                <Run Text="{Binding Name, Mode=OneWay}" />
                                                <Run Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Class, Mode=OneWay, StringFormat=' ({0})'}" />
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource SecondaryText}">
                                                <Run Text="{Binding ErrorCode, Mode=OneWay, StringFormat='Código {0}: '}" />
                                                <Run Text="{Binding Explanation, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </ui:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ui:Card
                        Style="{StaticResource RepairCard}"
                        Padding="16,12"
                        VerticalAlignment="Stretch"
                        VerticalContentAlignment="Stretch">
                        <DockPanel>
                            <DockPanel Margin="0,0,0,8" DockPanel.Dock="Top">
                                <CheckBox
                                    Content="Mostrar drivers da Microsoft"
                                    DockPanel.Dock="Right"
                                    IsChecked="{Binding ShowMicrosoftDrivers}" />
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Drivers (mais antigos primeiro)" />
                            </DockPanel>
                            <Grid Margin="0,0,0,4" DockPanel.Dock="Top">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontWeight="SemiBold" Style="{StaticResource SecondaryText}" Text="Dispositivo" />
                                <TextBlock Grid.Column="1" FontWeight="SemiBold" Style="{StaticResource SecondaryText}" Text="Fabricante do driver" />
                                <TextBlock Grid.Column="2" FontWeight="SemiBold" Style="{StaticResource SecondaryText}" Text="Versão" />
                                <TextBlock Grid.Column="3" FontWeight="SemiBold" Style="{StaticResource SecondaryText}" Text="Data" />
                            </Grid>
                            <ListBox
                                Background="Transparent"
                                BorderThickness="0"
                                ItemsSource="{Binding Drivers}"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                VirtualizingPanel.IsVirtualizing="True">
                                <ListBox.ItemContainerStyle>
                                    <Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0,3" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="200" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="100" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Driver.Device}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Driver.Class}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Driver.Provider}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Text="{Binding Driver.Version}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="3" Text="{Binding DateText}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOld}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource StatusWarningBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </ui:Card>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>

</UserControl>
