<UserControl
    x:Class="OtimizaPC.App.Views.RepairView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <DockPanel Margin="28,24,28,24">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Style="{StaticResource PageTitle}" Text="Reparo" />
            <TextBlock Style="{StaticResource PageSubtitle}" Text="Ferramentas de diagnóstico e reparo do Windows em um só lugar." />
        </StackPanel>

        <TabControl SelectedIndex="{Binding SelectedTab}">
            <!-- ================= Ferramentas ================= -->
            <TabItem Header="Ferramentas">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="420" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding ToolGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ui:Card
                                            Style="{StaticResource RepairCard}"
                                            Margin="0,0,0,12"
                                            Padding="16,12"
                                            HorizontalContentAlignment="Stretch">
                                            <StackPanel>
                                                <TextBlock
                                                    Margin="0,0,0,4"
                                                    Style="{StaticResource SectionTitle}"
                                                    Text="{Binding Name}" />
                                                <ItemsControl ItemsSource="{Binding Items}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <DockPanel Margin="0,8">
                                                                <ui:Button
                                                                    Margin="12,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    Appearance="Secondary"
                                                                    Command="{Binding RunCommand}"
                                                                    Content="Executar"
                                                                    DockPanel.Dock="Right" />
                                                                <StackPanel>
                                                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextWrapping="Wrap" />
                                                                    <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding Description}" />
                                                                    <TextBlock
                                                                        FontSize="11"
                                                                        Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                                        Text="{Binding Detail}" />
                                                                </StackPanel>
                                                            </DockPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </ui:Card>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ui:Card Style="{StaticResource RepairCard}" Padding="16,12" HorizontalContentAlignment="Stretch">
                                <StackPanel>
                                    <TextBlock
                                        Margin="0,0,0,8"
                                        Style="{StaticResource SectionTitle}"
                                        Text="Atalhos do Windows" />
                                    <ItemsControl ItemsSource="{Binding Shortcuts}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="2" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <ui:Button
                                                    Margin="0,0,6,6"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    Appearance="Transparent"
                                                    Command="{Binding DataContext.OpenShortcutCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="{Binding Description}">
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                </ui:Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ui:Card>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Console -->
                    <ui:Card
                        Style="{StaticResource RepairCard}"
                        Grid.Column="2"
                        Padding="16,12"
                        VerticalAlignment="Stretch"
                        VerticalContentAlignment="Stretch">
                        <DockPanel>
                            <DockPanel Margin="0,0,0,8" DockPanel.Dock="Top">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <ui:Button
                                        Margin="0,0,8,0"
                                        Appearance="Secondary"
                                        Command="{Binding CancelCommand}"
                                        Content="Interromper"
                                        Icon="{ui:SymbolIcon Stop24}"
                                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                                    <ui:Button
                                        Appearance="Transparent"
                                            AutomationProperties.Name="Copiar saída do console"
                                        Command="{Binding CopyConsoleCommand}"
                                        Icon="{ui:SymbolIcon Copy24}"
                                        ToolTip="Copiar saída" />
                                </StackPanel>
                                <ui:ProgressRing
                                    Width="18"
                                    Height="18"
                                    Margin="0,0,10,0"
                                    DockPanel.Dock="Left"
                                    IsIndeterminate="True"
                                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SectionTitle}"
                                    Text="{Binding ConsoleTitle}"
                                    TextTrimming="CharacterEllipsis" />
                            </DockPanel>

                            <Border
                                Margin="0,8,0,0"
                                Padding="12,8"
                                BorderBrush="{Binding ResultStatus, Converter={StaticResource StatusToBrush}}"
                                BorderThickness="1"
                                CornerRadius="6"
                                DockPanel.Dock="Bottom"
                                Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon
                                        Margin="0,0,10,0"
                                        Foreground="{Binding ResultStatus, Converter={StaticResource StatusToBrush}}"
                                        Symbol="{Binding ResultStatus, Converter={StaticResource StatusToSymbol}}" />
                                    <TextBlock
                                        MaxWidth="560"
                                        Text="{Binding ResultText}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border
                                Background="{DynamicResource LogBackgroundBrush}"
                                CornerRadius="6">
                                <ListBox
                                    x:Name="ConsoleList"
                                    Padding="8"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontFamily="Consolas"
                                    FontSize="12"
                                    ItemsSource="{Binding ConsoleLines}"
                                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                    VirtualizingPanel.IsVirtualizing="True">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0" />
                                            <Setter Property="Focusable" Value="False" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter />
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Text}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource LogForegroundBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource LogErrorForegroundBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </DockPanel>
                    </ui:Card>
                </Grid>
            </TabItem>

            <!-- ================= Erros do sistema ================= -->
            <TabItem Header="Erros do sistema">
                <DockPanel Margin="0,12,0,0">
                    <DockPanel Margin="0,0,0,12" DockPanel.Dock="Top">
                        <ui:Button
                            Appearance="Secondary"
                            Command="{Binding LoadEventsCommand}"
                            Content="Atualizar"
                            DockPanel.Dock="Right"
                            Icon="{ui:SymbolIcon ArrowSync24}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource SecondaryText}"
                            Text="{Binding EventsStatus}" />
                    </DockPanel>
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Events}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ui:Card
                                        Style="{StaticResource RepairCard}"
                                        Margin="0,0,0,8"
                                        Padding="16,10"
                                        HorizontalContentAlignment="Stretch">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ui:SymbolIcon
                                                Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}"
                                                Style="{StaticResource StatusIcon}"
                                                Symbol="{Binding Status, Converter={StaticResource StatusToSymbol}}" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap" />
                                                <TextBlock
                                                    Text="{Binding Subject}"
                                                    Visibility="{Binding Subject, Converter={StaticResource NullToCollapsed}}" />
                                                <TextBlock
                                                    FontSize="12"
                                                    Style="{StaticResource SecondaryText}"
                                                    Text="{Binding Detail}" />
                                                <Expander Margin="0,4,0,0" Header="Mensagem do Windows">
                                                    <TextBox
                                                        Margin="0,4,0,0"
                                                        FontSize="12"
                                                        Style="{StaticResource SelectableText}"
                                                        Text="{Binding Message, Mode=OneWay}" />
                                                </Expander>
                                            </StackPanel>
                                        </Grid>
                                    </ui:Card>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- ================= Telas azuis ================= -->
            <TabItem Header="Telas azuis">
                <DockPanel Margin="0,12,0,0">
                    <DockPanel Margin="0,0,0,12" DockPanel.Dock="Top">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <ui:Button
                                Margin="0,0,8,0"
                                Appearance="Secondary"
                                Command="{Binding OpenMinidumpFolderCommand}"
                                Content="Pasta de despejos"
                                Icon="{ui:SymbolIcon FolderOpen24}" />
                            <ui:Button
                                Appearance="Secondary"
                                Command="{Binding LoadCrashesCommand}"
                                Content="Atualizar"
                                Icon="{ui:SymbolIcon ArrowSync24}" />
                        </StackPanel>
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource SecondaryText}"
                            Text="{Binding CrashesStatus}" />
                    </DockPanel>
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Crashes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ui:Card
                                        Style="{StaticResource RepairCard}"
                                        Margin="0,0,0,8"
                                        Padding="16,10"
                                        HorizontalContentAlignment="Stretch">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ui:SymbolIcon
                                                Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}"
                                                Style="{StaticResource StatusIcon}"
                                                Symbol="{Binding Status, Converter={StaticResource StatusToSymbol}}" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                                <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding Explanation}" />
                                                <TextBox
                                                    FontSize="11"
                                                    Style="{StaticResource SelectableText}"
                                                    Text="{Binding Detail, Mode=OneWay}"
                                                    Visibility="{Binding Detail, Converter={StaticResource NullToCollapsed}}" />
                                            </StackPanel>
                                            <TextBlock
                                                Grid.Column="2"
                                                Margin="12,0,0,0"
                                                Style="{StaticResource SecondaryText}"
                                                Text="{Binding When}" />
                                        </Grid>
                                    </ui:Card>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- ================= Dispositivos e drivers ================= -->
            <TabItem Header="Dispositivos e drivers">
                <DockPanel Margin="0,12,0,0">
                    <DockPanel Margin="0,0,0,12" DockPanel.Dock="Top">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <ui:Button
                                Margin="0,0,8,0"
                                Appearance="Secondary"
                                Command="{Binding OpenDeviceManagerCommand}"
                                Content="Gerenciador de Dispositivos" />
                            <ui:Button
                                Appearance="Secondary"
                                Command="{Binding LoadDevicesCommand}"
                                Content="Atualizar"
                                Icon="{ui:SymbolIcon ArrowSync24}" />
                        </StackPanel>
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource SecondaryText}"
                            Text="{Binding DevicesStatus}" />
                    </DockPanel>

                    <ItemsControl
                        Margin="0,0,0,8"
                        DockPanel.Dock="Top"
                        ItemsSource="{Binding DeviceProblems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:Card
                                    Style="{StaticResource RepairCard}"
                                    Margin="0,0,0,8"
                                    Padding="16,10"
                                    HorizontalContentAlignment="Stretch">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon
                                            Foreground="{DynamicResource StatusWarningBrush}"
                                            Style="{StaticResource StatusIcon}"
                                            Symbol="Warning24" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock FontWeight="SemiBold">
                                                <Run Text="{Binding Name, Mode=OneWay}" />
                                                <Run Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Class, Mode=OneWay, StringFormat=' ({0})'}" />
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource SecondaryText}">
                                                <Run Text="{Binding ErrorCode, Mode=OneWay, StringFormat='Código {0}: '}" />
                                                <Run Text="{Binding Explanation, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </ui:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ui:Card
                        Style="{StaticResource RepairCard}"
                        Padding="16,12"
                        VerticalAlignment="Stretch"
                        VerticalContentAlignment="Stretch">
                        <DockPanel>
                            <DockPanel Margin="0,0,0,8" DockPanel.Dock="Top">
                                <CheckBox
                                    Content="Mostrar drivers da Microsoft"
                                    DockPanel.Dock="Right"
                                    IsChecked="{Binding ShowMicrosoftDrivers}" />
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Drivers (mais antigos primeiro)" />
                            </DockPanel>
                            <Grid Margin="0,0,0,4" DockPanel.Dock="Top">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontWeight="SemiBold" Style="{StaticResource SecondaryText}" Text="Dispositivo" />
                                <TextBlock Grid.Column="1" FontWeight="SemiBold" Style="{StaticResource SecondaryText}" Text="Fabricante do driver" />
                                <TextBlock Grid.Column="2" FontWeight="SemiBold" Style="{StaticResource SecondaryText}" Text="Versão" />
                                <TextBlock Grid.Column="3" FontWeight="SemiBold" Style="{StaticResource SecondaryText}" Text="Data" />
                            </Grid>
                            <ListBox
                                Background="Transparent"
                                BorderThickness="0"
                                ItemsSource="{Binding Drivers}"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                VirtualizingPanel.IsVirtualizing="True">
                                <ListBox.ItemContainerStyle>
                                    <Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0,3" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="200" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="100" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Driver.Device}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Driver.Class}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Driver.Provider}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Text="{Binding Driver.Version}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="3" Text="{Binding DateText}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOld}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource StatusWarningBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </ui:Card>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
