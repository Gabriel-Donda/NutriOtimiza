<ui:FluentWindow
    x:Class="OtimizaPC.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:OtimizaPC.App.Views"
    xmlns:vm="clr-namespace:OtimizaPC.App.ViewModels"
    Title="OtimizaPC"
    Width="1280"
    Height="820"
    MinWidth="980"
    MinHeight="620"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen">

    <ui:FluentWindow.Resources>
        <!-- Cada ViewModel de página é exibido pela sua View -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HardwareViewModel}">
            <views:HardwareView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SensorsViewModel}">
            <views:SensorsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CleanupViewModel}">
            <views:CleanupView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DiskAnalyzerViewModel}">
            <views:DiskAnalyzerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OptimizationsViewModel}">
            <views:OptimizationsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StartupViewModel}">
            <views:StartupView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AppsViewModel}">
            <views:AppsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RepairViewModel}">
            <views:RepairView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ComingSoonViewModel}">
            <views:ComingSoonView />
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="OtimizaPC" Grid.Row="0" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Menu lateral -->
            <DockPanel Grid.Column="0" Margin="8,4,8,12">
                <StackPanel Margin="12,8" DockPanel.Dock="Bottom">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon
                            FontSize="14"
                            Foreground="{DynamicResource StatusOkBrush}"
                            Symbol="ShieldCheckmark24"
                            Visibility="{Binding IsAdministrator, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock
                            Margin="6,0,0,0"
                            FontSize="12"
                            Style="{StaticResource SecondaryText}"
                            Text="{Binding PrivilegeText}" />
                    </StackPanel>
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Style="{StaticResource SecondaryText}"
                        Text="{Binding VersionText}" />
                </StackPanel>

                <ListBox
                    Background="Transparent"
                    BorderThickness="0"
                    ItemsSource="{Binding NavItems}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    SelectedItem="{Binding SelectedItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,6" Orientation="Horizontal">
                                <ui:SymbolIcon FontSize="20" Symbol="{Binding Icon}" />
                                <TextBlock
                                    Margin="14,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Text="{Binding Title}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Conteúdo da página -->
            <Border
                Grid.Column="1"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,1,0,0"
                CornerRadius="8,0,0,0">
                <ContentControl Content="{Binding SelectedItem.Page}" Focusable="False" />
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
