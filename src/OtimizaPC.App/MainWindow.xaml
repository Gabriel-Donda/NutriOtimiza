<ui:FluentWindow
    x:Class="OtimizaPC.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:OtimizaPC.App.Views"
    xmlns:vm="clr-namespace:OtimizaPC.App.ViewModels"
    Title="NutriOtimiza"
    Icon="pack://application:,,,/Assets/app.ico"
    Width="1280"
    Height="820"
    MinWidth="980"
    MinHeight="620"
    WindowState="Maximized"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    FontFamily="{DynamicResource AppFontFamily}"
    FontSize="14"
    ExtendsContentIntoTitleBar="True"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    WindowBackdropType="None"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen">

    <ui:FluentWindow.Resources>
        <Style x:Key="NavigationItemStyle" TargetType="ListBoxItem">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisualStyle}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border
                            x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SurfaceNavigationHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SurfaceNavigationSelectedBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource NavigationSelectedForegroundBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource FocusStrokeBrush}" />
                                <Setter Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cada ViewModel de página é exibido pela sua View -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HardwareViewModel}">
            <views:HardwareView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SensorsViewModel}">
            <views:SensorsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CleanupViewModel}">
            <views:CleanupView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DiskAnalyzerViewModel}">
            <views:DiskAnalyzerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OptimizationsViewModel}">
            <views:OptimizationsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StartupViewModel}">
            <views:StartupView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AppsViewModel}">
            <views:AppsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RepairViewModel}">
            <views:RepairView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="NutriOtimiza · Nutriport" Grid.Row="0">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app-256.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Menu lateral -->
            <DockPanel Grid.Column="0" Margin="8,4,8,12">
                <!-- Marca -->
                <StackPanel
                    Margin="10,4,10,14"
                    DockPanel.Dock="Top"
                    Orientation="Horizontal">
                    <Image
                        Width="44"
                        Height="44"
                        RenderOptions.BitmapScalingMode="HighQuality"
                        Source="pack://application:,,,/Assets/app-256.png" />
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontFamily="{DynamicResource AppFontFamily}" FontSize="20" FontWeight="Bold">
                            <Run Foreground="{DynamicResource BrandTitleBrush}" Text="Nutri" /><Run Foreground="{DynamicResource BrandOrangeBrush}" Text="Otimiza" />
                        </TextBlock>
                        <TextBlock
                            FontSize="11"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="por Nutriport" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Margin="12,8" DockPanel.Dock="Bottom">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon
                            FontSize="14"
                            Foreground="{DynamicResource StatusOkBrush}"
                            Symbol="ShieldCheckmark24"
                            Visibility="{Binding IsAdministrator, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock
                            Margin="6,0,0,0"
                            FontSize="12"
                            Style="{StaticResource SecondaryText}"
                            Text="{Binding PrivilegeText}" />
                    </StackPanel>
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Style="{StaticResource SecondaryText}"
                        Text="{Binding VersionText}" />
                </StackPanel>

                <ListBox
                    Background="Transparent"
                    BorderThickness="0"
                    FocusVisualStyle="{StaticResource AppFocusVisualStyle}"
                    ItemsSource="{Binding NavItems}"
                    ItemContainerStyle="{StaticResource NavigationItemStyle}"
                    KeyboardNavigation.TabNavigation="Local"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    SelectedItem="{Binding SelectedItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon
                                    AutomationProperties.Name="{Binding Title}"
                                    FontSize="20"
                                    Symbol="{Binding Icon}" />
                                <TextBlock
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Text="{Binding Title}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Conteúdo da página -->
            <Border
                Grid.Column="1"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,1,0,0"
                CornerRadius="8,0,0,0">
                <DockPanel>
                    <!-- Aviso de nova versão -->
                    <Border
                        Margin="28,16,28,0"
                        Padding="14,10"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource StatusInfoBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        DockPanel.Dock="Top"
                        Visibility="{Binding HasUpdateBanner, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel>
                            <ui:Button
                                AutomationProperties.Name="Dispensar aviso de atualização"
                                Appearance="Transparent"
                                Command="{Binding DismissUpdateBannerCommand}"
                                DockPanel.Dock="Right"
                                Icon="{ui:SymbolIcon Dismiss24}"
                                ToolTip="Dispensar" />
                            <ui:Button
                                AutomationProperties.Name="Atualizar agora"
                                Margin="0,0,8,0"
                                Appearance="Primary"
                                Command="{Binding UpdateNowCommand}"
                                Content="Atualizar agora"
                                DockPanel.Dock="Right" />
                            <ui:SymbolIcon
                                Margin="0,0,10,0"
                                FontSize="20"
                                Foreground="{DynamicResource StatusInfoBrush}"
                                Symbol="ArrowDownload24" />
                            <TextBlock VerticalAlignment="Center" Text="{Binding UpdateBanner}" />
                        </DockPanel>
                    </Border>
                    <ContentControl Content="{Binding SelectedItem.Page}" Focusable="False" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
